<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TechTeaStudio.HyperionMinecraftLauncher.App</RootNamespace>
    <AssemblyName>HyperionMinecraftLauncher</AssemblyName>
    <!-- &lt;Version&gt; is inherited from Directory.Build.props which reads /VERSION. -->
    <Description>Avalonia desktop front-end for the Minecraft launcher.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      v0.32.7: embed the launcher's brand icon into the Win32 PE resources.
      Windows uses this for Explorer thumbnails, Alt+Tab, Task Manager,
      Start-menu shortcuts, pinned-taskbar items (before the window opens),
      and the tray-area notification fallback. The runtime in-window
      taskbar/title-bar icon is set separately on the Window itself via
      Icon="avares://...icon.png". Multi-size .ico (16/24/32/48/64/128/256)
      generated from /icon.png with PIL so Windows can pick the right DPI.
    -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- T18: Opt-in Native AOT configuration. Avalonia 11.2 + MSAL + CmlLib have not been validated for full Native AOT; this config is for future experimentation only. -->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseAot'">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.3.0" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.3.0.28" />
    <PackageReference Include="Material.Avalonia" Version="3.14.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
    <PackageReference Include="MinecraftSkinRender" Version="1.2.0" />
    <PackageReference Include="MinecraftSkinRender.Image" Version="1.2.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!--
      SkiaSharp 3.x split native binaries off into per-RID packages. Our managed wrapper is
      `SkiaSharp 3.119.2`, which refuses to bind to any libSkiaSharp.so outside the [119.0, 120.0)
      range.

      Two complications converge on Linux:
      1. `MinecraftSkinRender 1.2.0 -> Avalonia.Skia 11.2.3 -> SkiaSharp 2.88.9` pulls a
         TRANSITIVE `SkiaSharp.NativeAssets.Linux 2.88.9`, which deploys a 2.88.x
         libSkiaSharp.so into `runtimes/linux-x64/native/`. That .so happens to outlast our
         3.119.x bundle during build because NuGet treats `SkiaSharp.NativeAssets.Linux` and
         `SkiaSharp.NativeAssets.Linux.NoDependencies` as DIFFERENT packageIds; they don't
         unify, and the 2.88.9 file wins the deploy race.
      2. GitHub Actions ubuntu-latest images also ship libSkiaSharp 88.x at the OS level under
         /usr/lib, so even if the bundle is missing, dlopen finds the bad system one.

      Fix: pin `SkiaSharp.NativeAssets.Linux` at 3.119.2 as a DIRECT reference. A direct
      PackageReference always overrides a transitive one of the same ID, so the bundled
      libSkiaSharp.so in `runtimes/linux-x64/native/` becomes the 119.x version we need.

      We use the regular (non-`NoDependencies`) variant because Avalonia transitively wants
      this exact packageId; staying on the same ID is what makes the override unambiguous.
      The package's only "dependency" is libfontconfig at runtime, which the ubuntu-latest
      image already provides.

      Companion: .github/workflows/dotnet.yml sets LD_LIBRARY_PATH to our runtimes/linux-x64/
      native folder on the Ubuntu test step so dlopen prefers our 119.x .so over /usr/lib's
      88.x even when the .NET DllImport resolver short-circuits to system search.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperionMinecraftLauncher.Core\HyperionMinecraftLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    T22a (v0.31.0): Localization. The canonical English source for every UI string
    lives in Strings.resx. .NET 10's SDK auto-includes *.resx as <EmbeddedResource>;
    we only tag it here with the standard ResX code-gen metadata so future translations
    (Strings.{culture}.resx) drop in next to it without any extra wiring.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
