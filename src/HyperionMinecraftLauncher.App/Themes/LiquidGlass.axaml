<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Redirector. The launcher palette moved from the v0.29 "Liquid Glass" purple
    bubble / frosted-glass look to the official Minecraft palette in v0.32. The
    actual tokens now live in MinecraftPalette.axaml; this file is kept around
    so the path in App.axaml's ResourceInclude
    (avares://HyperionMinecraftLauncher/Themes/LiquidGlass.axaml) keeps working
    untouched. Every LG.* key the rest of the app binds to is defined inside
    the included dictionary - the names are unchanged, only the values moved.
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://HyperionMinecraftLauncher/Themes/MinecraftPalette.axaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
