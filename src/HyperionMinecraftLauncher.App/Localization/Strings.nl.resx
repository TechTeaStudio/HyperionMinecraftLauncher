  <!--
    Canonical English source for every user-facing string in Hyperion Minecraft Launcher.

    Conventions:
      - Keys are UpperCamelCase + dotted scope, e.g. "MainWindow.Title", "Sidebar.Home".
      - Format strings use positional placeholders {0}, {1}, ... (never named).
      - Do NOT add triple-hyphen horizontal-rule separators or em-dashes to any translation file:
        the author tracks these as tells of AI-generated copy. Use hyphens or commas.
      - Technical identifiers (mod-loader names "Fabric"/"Forge"/etc, IDs, URLs, version numbers)
        are NOT extracted - they stay as literals in the AXAML.

    To add a new culture: drop "Strings.{culture}.resx" alongside this file with the same keys.
    Missing keys automatically fall back to the English value here.
  -->
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
