<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:TechTeaStudio.HyperionMinecraftLauncher.App.Views"
        xmlns:sys="using:System"
        xmlns:loc="using:TechTeaStudio.HyperionMinecraftLauncher.App.Localization"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.EditInstanceDialog"
        Title="{x:Static loc:Strings.EditInstanceDialog_Title}"
        Width="640" Height="760"
        MinWidth="540" MinHeight="500"
        CanResize="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LG.WindowBackground}"
        FontFamily="Inter, Segoe UI, system-ui"
        RenderOptions.BitmapInterpolationMode="None">

  <Border Background="{DynamicResource LG.GlassSurface}"
          BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
          CornerRadius="15">
    <Grid RowDefinitions="36,*,Auto">

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#400D0D1B"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" x:Name="TitleText" Text="{x:Static loc:Strings.EditInstanceDialog_HeaderTitle}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Width="36" Height="36"
                  Background="Transparent" BorderThickness="0" CornerRadius="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <!-- Body. ScrollViewer wraps every section so even when the user shrinks the
           dialog to MinHeight (500) the Window resolution row remains reachable
           without hiding behind the sticky Cancel/Save footer below. Horizontal
           scrolling is disabled so wide content (icon grid, JVM args box) wraps
           instead of unlocking a horizontal scrollbar. -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="22,16">
        <StackPanel Spacing="14">

          <!-- General section header -->
          <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_GeneralSection}" FontFamily="{StaticResource MinecraftFont}"
                     FontSize="13" Foreground="White" Margin="0,0,0,2" />

          <!-- Name -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_InstanceNameLabel}" FontSize="12" Opacity="0.85" />
            <TextBox x:Name="NameBox" FontSize="13" />
          </StackPanel>

          <!-- Icon picker. The ItemsControl is centered against the body so the
               whole grid hugs the dialog's middle; the inner WrapPanel takes a
               fixed Width=540 so wrapping is predictable (8 tiles per row at
               48+2*Margin each fit comfortably) and the rightmost tile no longer
               clips at the dialog's right edge. Mirrors the EditInstanceIconDialog
               picker centering technique. -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_IconLabel}" FontSize="12" Opacity="0.85" />
            <ItemsControl x:Name="IconPicker" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"
                             HorizontalAlignment="Center"
                             Width="540" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sys:String">
                  <RadioButton GroupName="IconChoice"
                              Margin="2"
                              Tag="{Binding}"
                              Click="OnIconClicked"
                              Width="48" Height="48"
                              Background="{DynamicResource MaterialBackgroundBrush}"
                              BorderBrush="{DynamicResource MaterialPrimaryMidBrush}"
                              BorderThickness="1">
                    <Image Source="{ReflectionBinding Converter={x:Static local:IconKeyToUri.Instance}}"
                           Width="28" Height="28" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Java &amp; memory section header -->
          <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_JavaMemorySection}" FontFamily="{StaticResource MinecraftFont}"
                     FontSize="13" Foreground="White" Margin="0,8,0,2" />
          <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_JavaMemoryHint}"
                     FontSize="10" Opacity="0.55" TextWrapping="Wrap" />

          <!-- Min RAM -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditInstanceDialog_MinHeapLabel}" FontSize="12" Opacity="0.85" />
              <TextBlock Grid.Column="1" x:Name="MinRamLabel" FontSize="11" Opacity="0.85" />
            </Grid>
            <Slider x:Name="MinRamSlider" Minimum="256" TickFrequency="256" IsSnapToTickEnabled="True"
                    ValueChanged="OnMinRamChanged" />
          </StackPanel>

          <!-- Max RAM -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditInstanceDialog_MaxHeapLabel}" FontSize="12" Opacity="0.85" />
              <TextBlock Grid.Column="1" x:Name="MaxRamLabel" FontSize="11" Opacity="0.85" />
            </Grid>
            <Slider x:Name="MaxRamSlider" Minimum="512" TickFrequency="512" IsSnapToTickEnabled="True"
                    ValueChanged="OnMaxRamChanged" />
          </StackPanel>

          <!-- JVM arguments -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_JvmArgsLabel}" FontSize="12" Opacity="0.85" />
            <TextBox x:Name="JvmArgsBox"
                     Watermark="{x:Static loc:Strings.EditInstanceDialog_JvmArgsWatermark}"
                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11"
                     AcceptsReturn="True" Height="60" />
          </StackPanel>

          <!-- Game directory -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_GameDirLabel}" FontSize="12" Opacity="0.85" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" x:Name="GameDirBox"
                       Watermark="{x:Static loc:Strings.EditInstanceDialog_GameDirWatermark}" FontSize="11" />
              <Button Grid.Column="1" Content="{x:Static loc:Strings.EditInstanceDialog_BrowseButton}" FontSize="11"
                      Padding="10,4" Margin="6,0,0,0" Click="OnBrowseGameDir" />
            </Grid>
          </StackPanel>

          <!-- Window resolution -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_WindowResolutionLabel}" FontSize="12" Opacity="0.85" />
            <Grid ColumnDefinitions="Auto,Auto,12,Auto,Auto" RowDefinitions="Auto">
              <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.EditInstanceDialog_WidthShort}" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
              <NumericUpDown Grid.Column="1" x:Name="WidthBox" Width="110"
                             Minimum="0" Maximum="7680" Increment="1" FormatString="0" />
              <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.EditInstanceDialog_HeightShort}" FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
              <NumericUpDown Grid.Column="4" x:Name="HeightBox" Width="110"
                             Minimum="0" Maximum="4320" Increment="1" FormatString="0" />
            </Grid>
            <TextBlock Text="{x:Static loc:Strings.EditInstanceDialog_ResolutionHint}"
                       FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Grid Grid.Row="2" Margin="22,4,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Cancel}" Click="OnCancel"
                Padding="14,5" FontSize="12" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="{x:Static loc:Strings.EditInstanceDialog_SaveButton}"
                Click="OnSave"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="14,5"
                CornerRadius="15"
                Background="{StaticResource LG.BubbleGradient}"
                BorderBrush="{DynamicResource LG.GlassRimStrong}"
                BorderThickness="1"
                Foreground="White" />
      </Grid>
    </Grid>
  </Border>
</Window>
