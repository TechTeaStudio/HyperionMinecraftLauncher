<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:TechTeaStudio.HyperionMinecraftLauncher.App.Views"
        xmlns:sys="using:System"
        xmlns:loc="using:TechTeaStudio.HyperionMinecraftLauncher.App.Localization"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.EditInstanceIconDialog"
        Title="{x:Static loc:Strings.EditInstanceIconDialog_Title}"
        Width="560" Height="440"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LG.WindowBackground}"
        FontFamily="Inter, Segoe UI, system-ui"
        RenderOptions.BitmapInterpolationMode="None">

  <Border Background="{DynamicResource LG.GlassSurface}"
          BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
          CornerRadius="{StaticResource LG.RadiusCard}">
    <Grid RowDefinitions="36,*,Auto">

      <!-- Title bar (drag handle + close glyph). Mirrors NewInstanceDialog so the
           two icon-picker modals feel like siblings. -->
      <Border Grid.Row="0" Background="#400D0D1B"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" x:Name="TitleText" Text="{x:Static loc:Strings.EditInstanceIconDialog_HeaderTitle}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Width="36" Height="36"
                  Background="Transparent" BorderThickness="0" CornerRadius="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <!-- Body: subtitle + preview tile + scrollable centered icon grid. The
           ScrollViewer wraps the whole body so the picker remains reachable
           even when the dialog is shrunk; the WrapPanel inside is horizontally
           centered so tiles never lean against the left edge. -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Padding="22,16">
        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
          <TextBlock x:Name="SubtitleText" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Text="{x:Static loc:Strings.EditInstanceIconDialog_Subtitle}" />

          <!-- Live preview of the currently selected icon. The code-behind keeps the
               Source in sync as the user toggles radio tiles below. -->
          <Border HorizontalAlignment="Center"
                  Background="{DynamicResource LG.GlassSecondary}"
                  BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
                  CornerRadius="{StaticResource LG.RadiusItem}"
                  Padding="10">
            <Image x:Name="PreviewImage" Width="64" Height="64" />
          </Border>

          <!-- Icon grid: WrapPanel with HorizontalAlignment="Center" so the 15 tiles
               flow as a centered block regardless of how many fit per row. -->
          <ItemsControl x:Name="IconPicker" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="sys:String">
                <RadioButton GroupName="IconChoice"
                            Margin="3"
                            Tag="{Binding}"
                            Click="OnIconClicked"
                            Width="48" Height="48"
                            Background="{DynamicResource MaterialBackgroundBrush}"
                            BorderBrush="{DynamicResource MaterialPrimaryMidBrush}"
                            BorderThickness="1">
                  <Image Source="{ReflectionBinding Converter={x:Static local:IconKeyToUri.Instance}}"
                         Width="28" Height="28" />
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Footer: docks to the bottom of the root grid so it stays visible no matter
           how far the user scrolls the picker above. -->
      <Grid Grid.Row="2" Margin="22,4,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Cancel}" Click="OnCancel"
                Padding="14,5" FontSize="12" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="{x:Static loc:Strings.EditInstanceIconDialog_SaveButton}"
                Click="OnSave"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="14,5"
                CornerRadius="{StaticResource LG.RadiusButton}"
                Background="{DynamicResource LG.BubbleGradient}"
                BorderBrush="{DynamicResource LG.GlassRimStrong}"
                BorderThickness="1"
                Foreground="White" />
      </Grid>
    </Grid>
  </Border>
</Window>
