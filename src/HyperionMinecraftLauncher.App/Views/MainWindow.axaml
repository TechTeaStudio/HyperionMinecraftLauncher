<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TechTeaStudio.HyperionMinecraftLauncher.App.ViewModels"
        xmlns:controls="using:TechTeaStudio.HyperionMinecraftLauncher.App.Controls"
        xmlns:local="using:TechTeaStudio.HyperionMinecraftLauncher.App.Views"
        xmlns:instances="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Instances"
        xmlns:browsing="using:TechTeaStudio.HyperionMinecraftLauncher.Core.InstanceBrowsing"
        xmlns:crashes="using:TechTeaStudio.HyperionMinecraftLauncher.Core.CrashReports"
        xmlns:servers="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Servers"
        xmlns:accounts="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Auth.Accounts"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:mods="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Mods"
        xmlns:loc="using:TechTeaStudio.HyperionMinecraftLauncher.App.Localization"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static loc:Strings.MainWindow_Title}"
        Width="960" Height="580"
        MinWidth="800" MinHeight="500"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur, None"
        FontFamily="Inter, Segoe UI, DejaVu Sans, Liberation Sans, Noto Sans, system-ui"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        RenderOptions.BitmapInterpolationMode="None"
        RenderOptions.EdgeMode="Aliased">

  <Window.Resources>
    <!-- Minecraft palette overrides (v0.32.0): retunes the Material brushes so the
         entire window reads against the warm-dark Minecraft bed (#171615) instead
         of the previous purple translucent ramp. The originals still live in
         App.axaml so child windows that don't merge the Minecraft palette keep
         working.

         Mapping (matches LG.* in MinecraftPalette.axaml):
           Paper / CardBackground -> flat #262423 (bg-surface, the tile colour).
           Background             -> flat #312D2C (bg-surface-alt, the slightly
                                     darker inset for log boxes / nested fills).
           PrimaryDark            -> flat #202020 (bg-window, header strip).
           PrimaryMid / Light     -> Minecraft green so "primary" buttons / chips
                                     tint with the accent.
           Divider                -> #3D3938 (border-soft). -->
    <SolidColorBrush x:Key="MaterialPaperBrush"          Color="#262423" />
    <SolidColorBrush x:Key="MaterialCardBackgroundBrush" Color="#262423" />
    <SolidColorBrush x:Key="MaterialBackgroundBrush"     Color="#312D2C" />
    <SolidColorBrush x:Key="MaterialPrimaryDarkBrush"    Color="#202020" />
    <SolidColorBrush x:Key="MaterialDividerBrush"        Color="#3D3938" />

    <SolidColorBrush x:Key="MaterialPrimaryMidBrush"     Color="#3C8527" />
    <SolidColorBrush x:Key="MaterialPrimaryLightBrush"   Color="#6CC349" />
  </Window.Resources>


  <Panel>
    <!-- Acrylic underlay - paints a flat tinted frame behind the launcher chrome.
         TintColor is the warm-dark Minecraft window bed (#171615) so the system
         blur (when available) reads as the same near-black brown as the flat
         background brush on top. When the OS doesn't support acrylic / mica /
         blur, the flat brush below carries the whole look on its own. -->
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
          BackgroundSource="Digger"
          TintColor="#171615"
          TintOpacity="1"
          MaterialOpacity="0.85" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <!-- Flat Minecraft window background (#171615). Sits over the acrylic so the
         launcher has the same colour bed on every platform; the acrylic is what
         gives it depth where the host OS supports it. The previous purple
         top-to-bottom gradient and falling-light wedge were removed in v0.32. -->
    <Border Background="{DynamicResource LG.WindowBackground}"
            IsHitTestVisible="False" />

  <Grid ColumnDefinitions="Auto,*" RowDefinitions="48,Auto,*">

    <!-- =================== HEADER (drag region + window controls) =================== -->
    <!-- Header is the Minecraft system panel (#202020, bg-window) with a hard
         single-pixel dark-soft separator along the bottom edge so it reads as a
         distinct strip above the page body. -->
    <Border Grid.ColumnSpan="2" Background="#202020"
            BorderBrush="{DynamicResource LG.Divider}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <Grid Margin="12,0,0,0" ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- App logo + title (left) - also drag-handle -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/grass_block_side.png"
                 Width="24" Height="24" IsHitTestVisible="False" />
          <TextBlock Text="{x:Static loc:Strings.MainWindow_HeaderTitle}"
                     FontFamily="{StaticResource MinecraftFont}"
                     FontSize="14" Foreground="White" VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </StackPanel>

        <!-- Account chip (middle-right). The chip itself is a Button whose Flyout lists
             every cached account; clicking a row switches; the footer holds Add / Remove.
             Empty-state shows "Sign in with Microsoft" as the chip label and Add account in the flyout.
             Background uses the bg-surface-profile #464242 so the chip reads as the
             dedicated "profile" tile from the Mojang launcher palette. -->
        <Button x:Name="AccountChipButton"
                Grid.Column="2"
                Classes="AccountChip"
                Padding="8,4" Margin="0,0,8,0"
                Background="#464242"
                BorderBrush="{DynamicResource LG.GlassRim}"
                BorderThickness="1"
                CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Image Source="{Binding AvatarBitmap}"
                   Classes="Avatar"
                   Width="22" Height="22"
                   RenderOptions.BitmapInterpolationMode="None" />
            <TextBlock Text="{Binding AccountDisplay}" Foreground="White" VerticalAlignment="Center"
                       FontSize="12"
                       IsVisible="{Binding HasSession}" />
            <TextBlock Text="{x:Static loc:Strings.Header_SignInWithMicrosoft}" Foreground="White" VerticalAlignment="Center"
                       FontSize="12"
                       IsVisible="{Binding !HasSession}" />
            <Path Data="M 0,0 L 6,6 L 12,0" Stroke="White" StrokeThickness="1.5"
                  Width="12" Height="7" Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Transient">
              <Border Padding="6" MinWidth="280" Background="{DynamicResource MaterialPaperBrush}"
                      CornerRadius="15">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static loc:Strings.Header_AccountsLabel}"
                             FontFamily="{StaticResource MinecraftFont}" FontSize="10"
                             Foreground="{DynamicResource MaterialSecondaryMidBrush}"
                             Margin="4,2,4,4" />
                  <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:AccountWithBitmap">
                        <Button Classes="AccountRow"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="6,4"
                                Margin="0,0,0,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding #AccountChipButton.((vm:MainViewModel)DataContext).SwitchAccountCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <!-- v0.32.2 (T-flyout-avatar): each row shows the real per-account
                                 head face. Steve sits underneath as the fallback; the top
                                 Image renders only when HeadBitmap is non-null. Offline rows
                                 and failed fetches just keep showing the Steve face. -->
                            <Panel Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0">
                              <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/steve_face.png"
                                     Width="24" Height="24"
                                     RenderOptions.BitmapInterpolationMode="None" />
                              <Image Source="{Binding HeadBitmap}"
                                     Width="24" Height="24"
                                     IsVisible="{Binding HeadBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     RenderOptions.BitmapInterpolationMode="None" />
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Username}"
                                         FontSize="12" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Uuid, Converter={x:Static local:UuidToShort.Instance}}"
                                         FontSize="10" Opacity="0.6"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Path Grid.Column="2" Data="M 0,4 L 4,8 L 12,0"
                                  Stroke="{DynamicResource MaterialSecondaryMidBrush}"
                                  StrokeThickness="2" Width="14" Height="10"
                                  VerticalAlignment="Center" Margin="6,0,4,0">
                              <Path.IsVisible>
                                <MultiBinding Converter="{x:Static local:ActiveAccountMatchMulti.Instance}">
                                  <Binding Path="Id" />
                                  <Binding ElementName="AccountChipButton" Path="((vm:MainViewModel)DataContext).ActiveAccount" />
                                </MultiBinding>
                              </Path.IsVisible>
                            </Path>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Margin="2,4" Background="{DynamicResource MaterialDividerBrush}" />
                  <Button Content="{x:Static loc:Strings.Header_AddAccount}"
                          Command="{Binding AddAccountCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          FontSize="12" Padding="8,4"
                          Background="Transparent" />
                  <Button Content="{x:Static loc:Strings.Header_RemoveThisAccount}"
                          Command="{Binding RemoveAccountCommand}"
                          CommandParameter="{Binding ActiveAccount}"
                          IsVisible="{Binding ActiveAccount, Converter={x:Static ObjectConverters.IsNotNull}}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          FontSize="12" Padding="8,4"
                          Background="Transparent" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- Window controls (far right): min / max-restore / close -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Click="OnWindowMinimize" Classes="WinCtrl" ToolTip.Tip="{x:Static loc:Strings.WindowChrome_Minimize}">
            <Path Data="M 0,5 L 10,5" Stroke="White" StrokeThickness="1.2" Width="10" Height="10" />
          </Button>
          <Button Click="OnWindowMaximizeRestore" Classes="WinCtrl" ToolTip.Tip="{x:Static loc:Strings.WindowChrome_MaximizeRestore}">
            <Path Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                  Width="10" Height="10" />
          </Button>
          <Button Click="OnWindowClose" Classes="WinCtrl WinCtrlClose" ToolTip.Tip="{x:Static loc:Strings.WindowChrome_Close}">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- =================== LAUNCHER UPDATE BANNER (T16) =================== -->
    <!-- Visible only when MainViewModel.AvailableUpdate is set. Clicking the banner body
         opens the release URL in the default browser; the X dismisses for this session.
         Background is the Minecraft primary green #3C8527 so the banner pops against
         the warm-dark page bed and the white "click to open release page" caption is
         unambiguously readable. -->
    <Border Grid.Row="1" Grid.ColumnSpan="2"
            IsVisible="{Binding HasUpdateAvailable}"
            Background="#3C8527"
            BorderBrush="#2A641C"
            BorderThickness="0,0,0,1"
            Padding="0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <Button Grid.Column="0"
                Command="{Binding OpenReleasePageCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Padding="14,6"
                Cursor="Hand">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Download" Width="16" Height="16" Foreground="White" />
            <TextBlock Text="{Binding UpdateBannerText}"
                       Foreground="White" FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Command="{Binding DismissUpdateCommand}"
                ToolTip.Tip="{x:Static loc:Strings.WindowChrome_Dismiss}"
                Background="Transparent"
                BorderThickness="0"
                Padding="10,6"
                Margin="0,0,4,0">
          <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.4"
                Width="10" Height="10" />
        </Button>
      </Grid>
    </Border>

    <!-- =================== SIDEBAR =================== -->
    <!-- Border.Width is bound to a VM property that flips between 180 (expanded) and 56 (collapsed).
         The DoubleTransition on Width animates the change so the content reflows smoothly.
         The Auto column on the parent Grid lets this Border drive its own width.

         Background is the glass surface gradient; a thin LG.GlassRim line on the right
         separates it from the content area. -->
    <Border Grid.Row="2" Grid.Column="0" Name="SidebarBorder"
            Width="{Binding SidebarWidth}"
            Background="{DynamicResource LG.SurfaceVariant}"
            BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="0,0,1,0"
            ClipToBounds="True">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="QuadraticEaseOut" />
        </Transitions>
      </Border.Transitions>
      <StackPanel Spacing="1" Margin="6">

        <!-- Collapse / expand toggle (icon-only, sits above the nav radios). Chevron flips
             direction based on state. Tooltip explains the action since the button is icon-only. -->
        <Button Classes="SidebarToggle"
                Command="{Binding ToggleSidebarCommand}"
                HorizontalAlignment="Right"
                ToolTip.Tip="{x:Static loc:Strings.Sidebar_CollapseExpand}"
                Margin="0,0,0,6">
          <Panel>
            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="18" Height="18"
                                        IsVisible="{Binding !IsSidebarCollapsed}" />
            <materialIcons:MaterialIcon Kind="ChevronRight" Width="18" Height="18"
                                        IsVisible="{Binding IsSidebarCollapsed}" />
          </Panel>
        </Button>

        <RadioButton Content="{x:Static loc:Strings.Sidebar_Home}" GroupName="Nav"
                     IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                     Click="OnNavHome" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_Home}">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/grass_block_side.png"
                   Width="20" Height="20" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Installations}" GroupName="Nav"
                     IsChecked="{Binding IsInstallationsSelected, Mode=OneWay}"
                     Click="OnNavInstallations" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_Installations}">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/chest_iso.png"
                   Width="22" Height="22" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Skins}" GroupName="Nav"
                     IsChecked="{Binding IsSkinsSelected, Mode=OneWay}"
                     Click="OnNavSkins" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_Skins}">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/steve_face.png"
                   Width="20" Height="20" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Servers}" GroupName="Nav"
                     IsChecked="{Binding IsServersSelected, Mode=OneWay}"
                     Click="OnNavServers" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_Servers}">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/ender_pearl.png"
                   Width="20" Height="20" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Headless}" GroupName="Nav"
                     IsChecked="{Binding IsHeadlessServersSelected, Mode=OneWay}"
                     Click="OnNavHeadlessServers" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_HeadlessTooltip}">
          <RadioButton.Tag>
            <materialIcons:MaterialIcon Kind="ServerNetwork"
                                        Width="20" Height="20"
                                        Foreground="White" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Mods}" GroupName="Nav"
                     IsChecked="{Binding IsModsSelected, Mode=OneWay}"
                     Click="OnNavMods" Classes="Nav">
          <RadioButton.Tag>
            <materialIcons:MaterialIcon Kind="Puzzle"
                                        Width="20" Height="20"
                                        Foreground="White" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_News}" GroupName="Nav"
                     IsChecked="{Binding IsNewsSelected, Mode=OneWay}"
                     Click="OnNavNews" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_News}">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/writable_book.png"
                   Width="20" Height="20" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Settings}" GroupName="Nav"
                     IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                     Click="OnNavSettings" Classes="Nav"
                     ToolTip.Tip="{x:Static loc:Strings.Sidebar_Settings}">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/comparator.png"
                   Width="20" Height="20" />
          </RadioButton.Tag>
        </RadioButton>
        <RadioButton Content="{x:Static loc:Strings.Sidebar_Logs}" GroupName="Nav"
                     IsChecked="{Binding IsLogsSelected, Mode=OneWay}"
                     Click="OnNavLogs" Classes="Nav">
          <RadioButton.Tag>
            <Image Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/book.png"
                   Width="20" Height="20" />
          </RadioButton.Tag>
        </RadioButton>

        <Border Margin="4,12,4,6" Height="1" Background="{DynamicResource MaterialDividerBrush}" />

        <TextBlock Text="{Binding LauncherVersionLabel}"
                   FontFamily="{StaticResource MinecraftFont}" FontSize="10"
                   Opacity="0.55" Margin="10,2,0,0"
                   IsVisible="{Binding AreSidebarLabelsVisible}" />
      </StackPanel>
    </Border>

    <!-- =================== CONTENT =================== -->
    <Grid Grid.Row="2" Grid.Column="1" Margin="14,12">

      <!-- ==== HOME PAGE ==== -->
      <Grid IsVisible="{Binding IsHomeSelected}" Classes="Page" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Home_Title}"
                     FontFamily="{StaticResource MinecraftFont}"
                     FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Home_Subtitle}"
                     Opacity="0.65" FontSize="11" />
        </StackPanel>

        <!-- Instances (saved + auto-imported from .minecraft/versions/) -->
        <Border Grid.Row="1" Padding="10" Margin="0,0,0,6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                   Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/grass_block_side.png"
                   Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:Strings.Home_YourInstancesLabel}"
                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"
                      ItemsSource="{Binding Instances}"
                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                      PlaceholderText="{x:Static loc:Strings.Home_YourInstancesPlaceholder}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="instances:Instance">
                  <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Row="1" Grid.Column="2"
                    Content="{x:Static loc:Strings.Home_RescanButton}" FontSize="11"
                    Command="{Binding RefreshInstancesCommand}"
                    Padding="10,4" Margin="8,2,0,0" />
          </Grid>
        </Border>

        <!-- Manifest versions row -->
        <Border Grid.Row="2" Padding="10" Margin="0,0,0,6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="4"
                   Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/compass.png"
                   Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static loc:Strings.Home_OrInstallAnother}"
                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />

            <!-- Search box. Filters FilteredVersions on every keystroke. -->
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                     Text="{Binding VersionSearchText, Mode=TwoWay}"
                     Watermark="{x:Static loc:Strings.Home_SearchVersionWatermark}"
                     FontSize="11" />

            <!-- Type-filter chips. Single horizontal row, compact. -->
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                        Spacing="4" Margin="0,4,0,0">
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipRelease}"   Classes="Chip" IsChecked="{Binding ShowRelease,  Mode=TwoWay}" />
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipSnapshot}"  Classes="Chip" IsChecked="{Binding ShowSnapshot, Mode=TwoWay}" />
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipOldBeta}"  Classes="Chip" IsChecked="{Binding ShowOldBeta,  Mode=TwoWay}" />
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipOldAlpha}" Classes="Chip" IsChecked="{Binding ShowOldAlpha, Mode=TwoWay}" />
            </StackPanel>

            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                      ItemsSource="{Binding FilteredVersions}"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      PlaceholderText="{x:Static loc:Strings.Home_ManifestPlaceholder}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Row="3" Grid.Column="2"
                    Content="{x:Static loc:Strings.Home_RefreshManifestButton}" FontSize="11"
                    Command="{Binding RefreshVersionsCommand}"
                    Padding="10,4" Margin="8,4,0,0" />
          </Grid>
        </Border>

        <!-- Username + Launch row -->
        <Border Grid.Row="3" Padding="10" Margin="0,0,0,8" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Image Grid.Column="0" Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/steve_face.png"
                   Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Home_OfflineUsernameLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="2" Text="{Binding Username, Mode=TwoWay}" Watermark="{x:Static loc:Strings.Home_OfflineUsernameWatermark}" FontSize="12"
                     IsEnabled="{Binding !IsSignedInOnline}" />
            <Button Grid.Column="3"
                    Content="{x:Static loc:Strings.Home_ResumeWorldButton}"
                    Click="OnResumeWorldClicked"
                    FontSize="11"
                    Padding="10,5" Margin="8,0,0,0"
                    ToolTip.Tip="{x:Static loc:Strings.Home_ResumeWorldTooltip}" />
            <Button Grid.Column="4"
                    Content="{x:Static loc:Strings.Home_LaunchButton}"
                    Command="{Binding LaunchCommand}"
                    Classes="accent LaunchBtn"
                    FontFamily="{StaticResource MinecraftFont}"
                    FontSize="14"
                    Padding="18,6" Margin="8,0,0,0"
                    Foreground="White" />
          </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="15"
                Background="{DynamicResource MaterialBackgroundBrush}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                     FontSize="11"
                     Padding="8" />
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- ==== INSTALLATIONS PAGE ==== -->
      <Grid IsVisible="{Binding IsInstallationsSelected}" Classes="Page" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Installations_Title}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Installations_Subtitle}"
                     Opacity="0.65" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Content="{x:Static loc:Strings.Installations_NewInstance}"
                  Click="OnNewInstanceClicked"
                  Classes="LaunchBtn"
                  FontFamily="{StaticResource MinecraftFont}" FontSize="12"
                  Padding="14,5"
                  Foreground="White" />
          <Button Content="{x:Static loc:Strings.Installations_ImportFromZip}" FontSize="11"
                  Command="{Binding ImportInstanceCommand}"
                  ToolTip.Tip="{x:Static loc:Strings.Installations_ImportFromZipTooltip}"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.Installations_ImportFromMultiMc}" FontSize="11"
                  Command="{Binding ImportMultiMcCommand}"
                  Classes="LaunchBtn"
                  FontFamily="{StaticResource MinecraftFont}"
                  ToolTip.Tip="{x:Static loc:Strings.Installations_ImportFromMultiMcTooltip}"
                  Foreground="White"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.Installations_ImportModpack}"
                  Click="OnImportModpackClicked"
                  IsVisible="{Binding CanImportModpack}"
                  FontSize="11"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.Installations_Refresh}" FontSize="11"
                  Command="{Binding RefreshInstancesCommand}"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.Installations_DeleteSelected}" FontSize="11"
                  Command="{Binding DeleteInstanceCommand}"
                  Padding="10,5" />
        </StackPanel>
        <!-- Modpack import strip: only visible while an import is running. -->
        <Border Grid.Row="2" Margin="0,0,0,8" Padding="10,6"
                CornerRadius="10"
                Background="#33FFFFFF"
                BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
                IsVisible="{Binding IsImportingModpack}">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding ModpackImportStatus}" FontSize="11" Foreground="White" />
            <ProgressBar Value="{Binding ModpackImportProgress}" Minimum="0" Maximum="1"
                         Height="6" />
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
          <ListBox ItemsSource="{Binding Instances}"
                   SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="instances:Instance">
                <Border Width="130" Height="148" Margin="6" CornerRadius="15"
                        Background="{DynamicResource MaterialPaperBrush}"
                        BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1"
                        Classes="Card"
                        Tag="{Binding}">
                  <!-- Right-click + "..." overflow both route into the same handler so
                       the user can change the icon either way. The menu/button is hidden
                       on auto-imported tiles (those belong to the official launcher's
                       versions/ folder; Hyperion doesn't persist edits for them). -->
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{x:Static loc:Strings.Installations_MenuEditInstance}"
                                Click="OnEditInstanceMenuClicked"
                                Tag="{Binding}"
                                IsEnabled="{Binding !IsAutoImported}" />
                      <MenuItem Header="{x:Static loc:Strings.Installations_MenuChangeIcon}"
                                Click="OnChangeIconMenuClicked"
                                Tag="{Binding}"
                                IsEnabled="{Binding !IsAutoImported}" />
                      <MenuItem Header="{x:Static loc:Strings.Installations_MenuExportToZip}"
                                Click="OnExportInstanceMenuClicked"
                                Tag="{Binding}"
                                IsEnabled="{Binding !IsAutoImported}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid>
                    <Grid RowDefinitions="*,Auto,Auto">
                      <Image Grid.Row="0"
                             Source="{Binding IconKey, Converter={x:Static local:IconKeyToUri.Instance}}"
                             Stretch="Uniform" Margin="14"
                             RenderOptions.BitmapInterpolationMode="None" />
                      <TextBlock Grid.Row="1" Text="{Binding Name}"
                                 FontWeight="SemiBold" FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 HorizontalAlignment="Center" Margin="6,0" />
                      <TextBlock Grid.Row="2" Text="{Binding VersionId}"
                                 Opacity="0.65" FontSize="10"
                                 HorizontalAlignment="Center" Margin="6,2,6,8" />
                    </Grid>
                    <!-- "auto" pill on instances synthesised from .minecraft/versions/.
                         Quietly signals they live in the official launcher's folder and
                         aren't deletable from Hyperion's own store. -->
                    <Border Background="#992A5616" CornerRadius="4" Padding="5,1"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,5,0"
                            IsVisible="{Binding IsAutoImported}">
                      <TextBlock Text="{x:Static loc:Strings.Installations_AutoBadge}" FontSize="9" Foreground="White"
                                 FontWeight="SemiBold" />
                    </Border>
                    <!-- Discoverability fallback: small overflow button in the bottom-right
                         corner of every user-created tile. Opens a menu mirroring the right-click
                         context menu (change icon, export, open folder, delete). Hidden on
                         auto-imported tiles.

                         Bug 4 (v0.32.0): the button was invisible against the previous frosted
                         palette and the MenuFlyout's MenuItems lost their DataContext (Avalonia
                         hosts the Flyout in a separate popup root, so {Binding} on a MenuItem
                         resolves to null and the click handler short-circuited). Fixed by
                         repainting the button against the new Minecraft surface (#3C8527 green
                         pill with a pixel-style dark outline) and routing the MenuItem Tag
                         through the Button's own Tag via $parent[Button].Tag, which works
                         across the popup boundary because it's a name lookup, not a tree walk. -->
                    <Button x:Name="InstanceMoreButton"
                            Content="..."
                            Tag="{Binding}"
                            ToolTip.Tip="{x:Static loc:Strings.Installations_MoreTooltip}"
                            Padding="0"
                            Width="26" Height="22"
                            FontSize="12" FontWeight="Bold"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Margin="0,4,4,0"
                            Background="#3C8527" Foreground="White"
                            BorderBrush="#000000" BorderThickness="1"
                            CornerRadius="3"
                            IsVisible="{Binding !IsAutoImported}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{x:Static loc:Strings.Installations_MenuChangeIcon}"
                                    Click="OnChangeIconMenuClicked"
                                    Tag="{Binding #InstanceMoreButton.Tag}" />
                          <MenuItem Header="{x:Static loc:Strings.Installations_MenuExportToZip}"
                                    Click="OnExportInstanceMenuClicked"
                                    Tag="{Binding #InstanceMoreButton.Tag}" />
                          <MenuItem Header="{x:Static loc:Strings.Installations_MenuOpenFolder}"
                                    Click="OnOpenInstanceFolderMenuClicked"
                                    Tag="{Binding #InstanceMoreButton.Tag}" />
                          <MenuItem Header="{x:Static loc:Strings.Installations_MenuDelete}"
                                    Click="OnDeleteInstanceMenuClicked"
                                    Tag="{Binding #InstanceMoreButton.Tag}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <!-- Per-instance detail panel: screenshots / worlds / servers, scoped to the selected instance's gameDir. -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}"
                BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1"
                MinHeight="220"
                IsVisible="{Binding HasSelectedInstance}">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_Screenshots}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsScreenshotsTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabScreenshots" />
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_Worlds}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsWorldsTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabWorlds" />
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_Servers}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsInstanceServersTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabServers" />
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_Crashes}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsCrashesTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabCrashes" />
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_ResourcePacks}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsResourcePacksTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabResourcePacks" />
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_ShaderPacks}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsShaderPacksTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabShaderPacks" />
                <RadioButton Content="{x:Static loc:Strings.InstanceTabs_DataPacks}" GroupName="InstanceTabs"
                             Classes="DetailTab"
                             IsChecked="{Binding IsDataPacksTabSelected, Mode=OneWay}"
                             Click="OnInstanceTabDataPacks" />
                <Button Content="{x:Static loc:Strings.InstanceTabs_RefreshButton}" FontSize="10" Padding="8,2" Margin="14,0,0,0"
                        Click="OnRefreshInstanceTab" />
                <Button Content="{x:Static loc:Strings.InstanceTabs_OpenFolderButton}" FontSize="10" Padding="8,2" Margin="4,0,0,0"
                        Click="OnOpenCrashReportsFolder"
                        IsVisible="{Binding IsCrashesTabSelected}" />
                <Button Content="{x:Static loc:Strings.InstanceTabs_OpenFolderButton}" FontSize="10" Padding="8,2" Margin="4,0,0,0"
                        Click="OnOpenResourcePacksFolder"
                        IsVisible="{Binding IsResourcePacksTabSelected}" />
                <Button Content="{x:Static loc:Strings.InstanceTabs_OpenFolderButton}" FontSize="10" Padding="8,2" Margin="4,0,0,0"
                        Click="OnOpenShaderPacksFolder"
                        IsVisible="{Binding IsShaderPacksTabSelected}" />
                <Button Content="{x:Static loc:Strings.InstanceTabs_OpenFolderButton}" FontSize="10" Padding="8,2" Margin="4,0,0,0"
                        Click="OnOpenSavesFolder"
                        IsVisible="{Binding IsDataPacksTabSelected}" />
              </StackPanel>
              <!-- Bug 3 (v0.32.0): the detail panel had no way to be dismissed. This X
                   button nulls SelectedInstance, which collapses the whole Border via
                   the IsVisible="HasSelectedInstance" binding above. Uses the same
                   WinCtrl style as the header window controls so the click target is
                   consistent with the rest of the chrome. -->
              <Button Grid.Column="1"
                      Classes="WinCtrl"
                      Width="28" Height="22"
                      Padding="0"
                      Command="{Binding CloseInstanceDetailCommand}"
                      ToolTip.Tip="{x:Static loc:Strings.WindowChrome_Close}">
                <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="White" StrokeThickness="1.4"
                      Width="9" Height="9" />
              </Button>
            </Grid>

            <!-- Screenshots tab: WrapPanel of 160x100 thumbnail tiles. Click opens with OS default viewer. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsScreenshotsTabSelected}">
              <ItemsControl ItemsSource="{Binding InstanceScreenshots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="browsing:ScreenshotEntry">
                    <Border Width="160" Height="118" Margin="4" CornerRadius="10"
                            Background="{DynamicResource MaterialBackgroundBrush}"
                            BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1"
                            Classes="Card"
                            ToolTip.Tip="{Binding Filename}">
                      <Grid RowDefinitions="100,*">
                        <Border Grid.Row="0" Background="#33000000">
                          <Image Source="{Binding FullPath, Converter={x:Static local:PngPathToThumbnail.Instance}}"
                                 Stretch="UniformToFill"
                                 Tag="{Binding FullPath}"
                                 PointerPressed="OnScreenshotPressed" />
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding Filename}"
                                   FontSize="9" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="4,2,4,2" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Worlds tab: ListBox with name, display name, last played, size. Right-click opens folder. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsWorldsTabSelected}">
              <ListBox ItemsSource="{Binding InstanceWorlds}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="browsing:WorldEntry">
                    <Border Padding="6,4" Tag="{Binding FullPath}"
                            PointerReleased="OnWorldRowPointerReleased">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{x:Static loc:Strings.InstanceTabs_WorldMenuOpenFolder}"
                                    Tag="{Binding FullPath}"
                                    Click="OnWorldOpenFolderMenuClicked" />
                          <Separator />
                          <MenuItem Header="{x:Static loc:Strings.InstanceTabs_WorldMenuBackupNow}"
                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).BackupWorldCommand}"
                                    CommandParameter="{Binding FolderName}" />
                          <MenuItem Header="{x:Static loc:Strings.InstanceTabs_WorldMenuRestoreLatest}"
                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RestoreLatestBackupCommand}"
                                    CommandParameter="{Binding FolderName}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding FolderName}" Opacity="0.6" FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding LastPlayedIso, Converter={x:Static local:IsoToHumanizedAgo.Instance}}"
                                   Opacity="0.7" FontSize="10" VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SizeBytes, Converter={x:Static local:ByteSizeFormatter.Instance}}"
                                   Opacity="0.55" FontSize="10" VerticalAlignment="Center"
                                   Margin="10,0,0,0" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                   Text="{Binding Version}" Opacity="0.55" FontSize="10"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>

            <!-- Servers tab: plain list of name + ip from this instance's servers.dat. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsInstanceServersTabSelected}">
              <ListBox ItemsSource="{Binding InstanceServers}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="servers:ServerListEntry">
                    <Grid ColumnDefinitions="Auto,*" Margin="2,3">
                      <Image Grid.Column="0" Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/ender_pearl.png"
                             Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding Ip}" Opacity="0.65" FontSize="10" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>

            <!-- Crashes tab: top half lists each parsed crash report, bottom half shows the
                 full text + a button strip with mod-search links for each suspect mod. -->
            <Grid Grid.Row="1" IsVisible="{Binding IsCrashesTabSelected}"
                  RowDefinitions="*,2,*">
              <!-- Top half: list of crash reports -->
              <Border Grid.Row="0" CornerRadius="8"
                      Background="{DynamicResource MaterialBackgroundBrush}">
                <Grid RowDefinitions="*,Auto">
                  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding InstanceCrashReports}"
                             SelectedItem="{Binding SelectedCrashReport, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="crashes:CrashReport">
                          <Grid ColumnDefinitions="*,Auto" Margin="2,3" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Filename}" FontWeight="SemiBold" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       FontSize="10" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding MinecraftVersion}" />
                              <Run Text="{x:Static loc:Strings.InstanceTabs_CrashSeparatorDash}" />
                              <Run Text="{Binding SummaryLine}" />
                            </TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                       Text="{Binding GeneratedAt, Converter={x:Static local:DateTimeOffsetToHumanizedAgo.Instance}}"
                                       Opacity="0.6" FontSize="10" VerticalAlignment="Center"
                                       Margin="10,0,4,0" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                  <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.InstanceTabs_NoCrashReports}"
                             FontSize="10" Opacity="0.55" Margin="6,4"
                             IsVisible="{Binding !HasInstanceCrashReports}" />
                </Grid>
              </Border>

              <!-- Bottom half: viewer + mod search button strip -->
              <Border Grid.Row="2" CornerRadius="8"
                      Background="{DynamicResource MaterialBackgroundBrush}"
                      IsVisible="{Binding HasSelectedCrashReport}">
                <Grid RowDefinitions="Auto,*">
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding SelectedCrashReportSuspects}"
                                Margin="6,4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="crashes:CrashFrame">
                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,8,2">
                          <TextBlock Text="{Binding ModDisplayName}" FontWeight="SemiBold" FontSize="11"
                                     VerticalAlignment="Center" />
                          <Button Content="{x:Static loc:Strings.InstanceTabs_SearchModrinth}" Padding="6,2" FontSize="10"
                                  Tag="{Binding ModrinthSearchUrl}"
                                  Click="OnOpenCrashSuspectUrl" />
                          <Button Content="{x:Static loc:Strings.InstanceTabs_SearchCurseForge}" Padding="6,2" FontSize="10"
                                  Tag="{Binding CurseForgeSearchUrl}"
                                  Click="OnOpenCrashSuspectUrl" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Grid.Row="1"
                           Text="{Binding SelectedCrashReport.FullText, Mode=OneWay}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Cascadia Mono, Consolas, monospace"
                           FontSize="10"
                           Background="Transparent"
                           Margin="6,2,6,6"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
              </Border>
            </Grid>

            <!-- Resource packs tab: ListBox over InstanceResourcePacks, with enable toggle + remove. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsResourcePacksTabSelected}">
              <Grid RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding InstanceResourcePacks}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="browsing:ResourcePackEntry">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,3">
                        <Image Grid.Column="0"
                               Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/book.png"
                               Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SizeBytes, Converter={x:Static local:ByteSizeFormatter.Instance}}"
                                     Opacity="0.55" FontSize="10" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      Tag="{Binding Filename}"
                                      Click="OnToggleResourcePack"
                                      ToolTip.Tip="{x:Static loc:Strings.InstanceTabs_PackEnableTooltip}"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0" />
                        <Button Grid.Column="3"
                                Content="{x:Static loc:Strings.InstanceTabs_PackRemoveButton}"
                                FontSize="10" Padding="8,2" Margin="6,0,0,0"
                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveResourcePackCommand}"
                                CommandParameter="{Binding Filename}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.InstanceTabs_PackEmptyResource}"
                           FontSize="10" Opacity="0.55" Margin="6,4"
                           IsVisible="{Binding !InstanceResourcePacks.Count}" />
              </Grid>
            </ScrollViewer>

            <!-- Shader packs tab: mirror of resource packs but pointing at shaderpacks/. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsShaderPacksTabSelected}">
              <Grid RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding InstanceShaderPacks}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="browsing:ShaderPackEntry">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,3">
                        <Image Grid.Column="0"
                               Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/redstone.png"
                               Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SizeBytes, Converter={x:Static local:ByteSizeFormatter.Instance}}"
                                     Opacity="0.55" FontSize="10" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      Tag="{Binding Filename}"
                                      Click="OnToggleShaderPack"
                                      ToolTip.Tip="{x:Static loc:Strings.InstanceTabs_PackEnableTooltip}"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0" />
                        <Button Grid.Column="3"
                                Content="{x:Static loc:Strings.InstanceTabs_PackRemoveButton}"
                                FontSize="10" Padding="8,2" Margin="6,0,0,0"
                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveShaderPackCommand}"
                                CommandParameter="{Binding Filename}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.InstanceTabs_PackEmptyShader}"
                           FontSize="10" Opacity="0.55" Margin="6,4"
                           IsVisible="{Binding !InstanceShaderPacks.Count}" />
              </Grid>
            </ScrollViewer>

            <!-- Data packs tab: flat list but each row prefixes the owning world folder so
                 the user can read "(world) packname" at a glance. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsDataPacksTabSelected}">
              <Grid RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding InstanceDataPacks}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="browsing:DataPackEntry">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="2,3">
                        <Image Grid.Column="0"
                               Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/writable_book.png"
                               Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Opacity="0.55" FontSize="10">
                            <Run Text="{Binding WorldFolderName}" />
                            <Run Text=" - " />
                            <Run Text="{Binding SizeBytes, Converter={x:Static local:ByteSizeFormatter.Instance}}" />
                          </TextBlock>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      Tag="{Binding}"
                                      Click="OnToggleDataPack"
                                      ToolTip.Tip="{x:Static loc:Strings.InstanceTabs_PackEnableTooltip}"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0" />
                        <Button Grid.Column="3"
                                Content="{x:Static loc:Strings.InstanceTabs_PackRemoveButton}"
                                FontSize="10" Padding="8,2" Margin="6,0,0,0"
                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveDataPackCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.InstanceTabs_PackEmptyData}"
                           FontSize="10" Opacity="0.55" Margin="6,4"
                           IsVisible="{Binding !InstanceDataPacks.Count}" />
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ==== SKINS PAGE ==== -->
      <Grid IsVisible="{Binding IsSkinsSelected}" Classes="Page" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Skins_Title}" FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Skins_Subtitle}"
                     Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Upload + cape picker row -->
        <Border Grid.Row="1" Padding="10" Margin="0,0,0,6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{x:Static loc:Strings.Skins_UploadButton}"
                    Command="{Binding UploadSkinCommand}"
                    Classes="LaunchBtn"
                    FontFamily="{StaticResource MinecraftFont}" FontSize="12"
                    Padding="14,5"
                    Foreground="White" />
            <Border Width="1" Background="{DynamicResource MaterialDividerBrush}" Margin="2,0" />
            <TextBlock Text="{x:Static loc:Strings.Skins_CapeLabel}" VerticalAlignment="Center" FontSize="12"
                       IsVisible="{Binding HasOwnedCapes}" />
            <ComboBox MinWidth="180"
                      ItemsSource="{Binding OwnedCapes}"
                      SelectedItem="{Binding SelectedActiveCape, Mode=TwoWay}"
                      PlaceholderText="{x:Static loc:Strings.Skins_CapeNonePlaceholder}"
                      IsVisible="{Binding HasOwnedCapes}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Alias}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{x:Static loc:Strings.Skins_ClearCape}"
                    Command="{Binding ClearActiveCapeCommand}"
                    FontSize="11" Padding="10,4"
                    IsVisible="{Binding HasOwnedCapes}" />
          </StackPanel>
        </Border>

        <!-- Recent skins gallery (history) -->
        <Border Grid.Row="2" Padding="6,8" Margin="0,0,0,6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.Skins_RecentSkins}" FontWeight="SemiBold" FontSize="12" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding SkinHistory}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="64" Height="64" Padding="0"
                            ToolTip.Tip="{x:Static loc:Strings.Skins_RecentReapplyTooltip}"
                            Click="OnReapplyHistoricSkinClicked"
                            Tag="{Binding}">
                      <Image Source="{Binding FilePath}"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapInterpolationMode="None" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Row 3: 3D preview (left) and community skin browser (right). -->
        <Grid Grid.Row="3" ColumnDefinitions="*,8,2*">
          <Border Grid.Column="0" CornerRadius="15"
                  Background="{DynamicResource MaterialPaperBrush}">
            <controls:SkinPreview x:Name="SkinViewer" />
          </Border>

          <!-- ===== Community skin browser (T-namemc, v0.32.1; pivoted to MineSkin in v0.32.3) =====
               Originally NameMC (Cloudflare-blocked since v0.32.2); now MineSkin v2 REST.
               Treat the gallery as a convenience, not a contract: any community source
               can disappear, rate-limit us, or change its schema. -->
          <Border Grid.Column="2" CornerRadius="15" Padding="8"
                  Background="{DynamicResource MaterialPaperBrush}"
                  IsVisible="{Binding IsSkinBrowserAvailable}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="{x:Static loc:Strings.SkinsBrowser_SectionTitle}"
                         FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />

              <!-- Search + "Show trending" controls + H1 (v0.32.4) Prev/Next pagination -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <TextBox Width="200"
                         Text="{Binding SkinSearchText, Mode=TwoWay}"
                         Watermark="{x:Static loc:Strings.SkinsBrowser_SearchWatermark}"
                         KeyDown="OnBrowsedSkinSearchKeyDown" />
                <Button Content="{x:Static loc:Strings.SkinsBrowser_ShowTrending}"
                        Command="{Binding RefreshTrendingSkinsCommand}"
                        FontSize="11" Padding="10,4" />
                <Button Content="{x:Static loc:Strings.SkinsBrowser_PrevPage}"
                        Command="{Binding PrevSkinPageCommand}"
                        ToolTip.Tip="{Binding CurrentSkinPageDisplay, StringFormat={x:Static loc:Strings.SkinsBrowser_PageLabel}}"
                        FontSize="11" Padding="10,4" />
                <Button Content="{x:Static loc:Strings.SkinsBrowser_NextPage}"
                        Command="{Binding NextSkinPageCommand}"
                        ToolTip.Tip="{Binding CurrentSkinPageDisplay, StringFormat={x:Static loc:Strings.SkinsBrowser_PageLabel}}"
                        FontSize="11" Padding="10,4" />
                <TextBlock Text="{Binding CurrentSkinPageDisplay, StringFormat={x:Static loc:Strings.SkinsBrowser_PageLabel}}"
                           FontSize="10" Opacity="0.75" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static loc:Strings.SkinsBrowser_Loading}"
                           FontSize="10" Opacity="0.65" VerticalAlignment="Center"
                           IsVisible="{Binding IsSkinBrowserBusy}" />
              </StackPanel>

              <!-- WrapPanel of thumbnails. v0.32.4 (H1): each card shows the assembled
                   minifigure body sprite (64x96 image well) over a near-invisible neutral
                   tile instead of the old green-tinted card with the raw sprite-sheet. -->
              <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding BrowsedSkins}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- v0.32.4 (H1): explicit Background + BorderBrush replace the default
                           green-tinted Button styling. The user asked for "a near-invisible
                           neutral grey, just one or two shades off the page background" so
                           the card carries a faint silhouette without an aggressive colour.
                           I1 (v0.32.5): when the card is a Mojang-resolved live-player skin
                           we drop a small "M" pip in the top-right corner so the user can
                           tell live tiles apart from regular MineSkin uploads at a glance. -->
                      <Button Width="74" Height="106" Padding="4" Margin="3"
                              Click="OnBrowsedSkinCardClicked"
                              Tag="{Binding}"
                              Background="{DynamicResource LG.SkinCardBackground}"
                              BorderBrush="{DynamicResource LG.GlassRim}"
                              BorderThickness="1"
                              ToolTip.Tip="{Binding Source.SourceUrl}">
                        <Grid>
                          <Image Source="{Binding MinifigureImage}"
                                 Width="64" Height="96"
                                 Stretch="Uniform"
                                 RenderOptions.BitmapInterpolationMode="None" />
                          <Border IsVisible="{Binding Source.IsLivePlayerSkin}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Background="#3A5BFF" CornerRadius="4"
                                  Padding="3,0" Margin="0,-2,-2,0"
                                  ToolTip.Tip="{x:Static loc:Strings.SkinsBrowser_MojangAccountBadgeTooltip}">
                            <TextBlock Text="M" Foreground="White" FontSize="8"
                                       FontWeight="Bold" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Selected-card preview + apply -->
              <Border Grid.Row="3" Margin="0,6,0,0" Padding="6"
                      CornerRadius="10"
                      Background="{DynamicResource MaterialPaperBrush}"
                      IsVisible="{Binding HasSelectedBrowsedSkin}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Image Grid.Column="0" Width="48" Height="48"
                         asyncImageLoader:ImageLoader.Source="{Binding SelectedBrowsedSkin.ThumbnailUrl}"
                         Stretch="UniformToFill"
                         RenderOptions.BitmapInterpolationMode="None"
                         Margin="0,0,8,0" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedBrowsedSkin.UploaderName}"
                               FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <!-- I1 (v0.32.5): live-player skin badge. Surfaces "Mojang account: {Name}"
                         so the user knows the tile points at a real online player's current
                         skin rather than an anonymous MineSkin gallery upload. -->
                    <TextBlock IsVisible="{Binding SelectedBrowsedSkin.IsLivePlayerSkin}"
                               FontSize="10" Opacity="0.85"
                               Foreground="#3A5BFF"
                               Text="{Binding SelectedBrowsedSkin.UploaderName, StringFormat={x:Static loc:Strings.SkinsBrowser_MojangAccountLabel}}" />
                    <ItemsControl ItemsSource="{Binding SelectedBrowsedSkin.Tags}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="4,1" CornerRadius="6"
                                  Background="{DynamicResource MaterialDividerBrush}">
                            <TextBlock Text="{Binding}" FontSize="9" Opacity="0.85" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Button Grid.Column="2"
                          Content="{x:Static loc:Strings.SkinsBrowser_ApplyButton}"
                          Command="{Binding ApplyBrowsedSkinCommand}"
                          CommandParameter="{Binding SelectedBrowsedSkin}"
                          Classes="LaunchBtn"
                          FontFamily="{StaticResource MinecraftFont}"
                          FontSize="11" Padding="12,4"
                          Foreground="White" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <StackPanel Grid.Row="4" Spacing="2" Margin="0,6,0,0">
          <TextBlock Text="{x:Static loc:Strings.Skins_DragHint}"
                     Opacity="0.55" FontSize="10" />
          <TextBlock Text="{x:Static loc:Strings.SkinsBrowser_PoweredBy}"
                     Opacity="0.45" FontSize="10"
                     IsVisible="{Binding IsSkinBrowserAvailable}" />
        </StackPanel>
      </Grid>

      <!-- ==== SERVERS PAGE ==== -->
      <Grid IsVisible="{Binding IsServersSelected}" Classes="Page" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Servers_Title}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Servers_Subtitle}"
                     Opacity="0.65" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <Button Content="{x:Static loc:Strings.Servers_RefreshServers}" FontSize="11"
                  Command="{Binding RefreshServersCommand}"
                  Padding="10,4" />
          <Button Content="{x:Static loc:Strings.Servers_RefreshPings}" FontSize="11"
                  Command="{Binding RefreshServerPingsCommand}"
                  Padding="10,4" />
        </StackPanel>
        <Border Grid.Row="2" Padding="6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <ListBox ItemsSource="{Binding Servers}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerListItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3">
                  <Image Grid.Column="0" Source="avares://HyperionMinecraftLauncher/Assets/Icons/MC/ender_pearl.png"
                         Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Ip}" Opacity="0.65" FontSize="10" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,2,0">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusLine}" FontSize="10" Opacity="0.85" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="{x:Static loc:Strings.Servers_JoinButton}"
                          FontSize="11" Padding="10,3" Margin="6,0,2,0"
                          VerticalAlignment="Center"
                          Click="OnJoinServerClicked" Tag="{Binding}"
                          ToolTip.Tip="{x:Static loc:Strings.Servers_JoinTooltip}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- ==== HEADLESS SERVERS PAGE (v0.28 T11, v0.32.1 console pane) ==== -->
      <Grid IsVisible="{Binding IsHeadlessServersSelected}" Classes="Page" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.HeadlessServers_Title}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.HeadlessServers_Subtitle}"
                     Opacity="0.65" FontSize="11" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Content="{x:Static loc:Strings.HeadlessServers_NewServer}"
                  Click="OnNewHeadlessServerClicked"
                  Classes="LaunchBtn"
                  FontFamily="{StaticResource MinecraftFont}" FontSize="12"
                  Padding="14,5"
                  Foreground="White" />
          <Button Content="{x:Static loc:Strings.HeadlessServers_Refresh}" FontSize="11"
                  Command="{Binding RefreshHeadlessServersCommand}"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.HeadlessServers_Start}" FontSize="11"
                  Command="{Binding StartHeadlessServerCommand}"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.HeadlessServers_Stop}" FontSize="11"
                  Command="{Binding StopHeadlessServerCommand}"
                  Padding="10,5" />
          <Button Content="{x:Static loc:Strings.HeadlessServers_Delete}" FontSize="11"
                  Command="{Binding DeleteHeadlessServerCommand}"
                  Padding="10,5" />
        </StackPanel>

        <!-- Per-server status label (v0.32.1). Shows "Stopped / Starting... / Running (pid X) / Stopping...". -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6"
                    IsVisible="{Binding IsHeadlessConsoleVisible}">
          <TextBlock Text="{x:Static loc:Strings.HeadlessServers_StatusLabel}"
                     FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
          <TextBlock Text="{Binding HeadlessSelectedStatus}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="11"
                     Foreground="White" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" Padding="6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <ListBox ItemsSource="{Binding HeadlessServers}"
                   SelectedItem="{Binding SelectedHeadlessServer, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4">
                  <materialIcons:MaterialIcon Grid.Column="0" Kind="ServerNetwork"
                                              Width="22" Height="22"
                                              Margin="0,0,10,0" VerticalAlignment="Center"
                                              Foreground="White" />
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Opacity="0.65" FontSize="10">
                      <Run Text="{Binding VersionId}" />
                      <Run Text="{x:Static loc:Strings.HeadlessServers_DashSeparator}" />
                      <Run Text="{Binding RamMb}" />
                      <Run Text="{x:Static loc:Strings.HeadlessServers_MibAndPort}" />
                      <Run Text="{Binding Port}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Path}"
                             Opacity="0.5" FontSize="10" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="280" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Console pane (v0.32.1): live stdout + a Send command box. Shown only when a
             server is selected; the buffer is per-server and capped at 10000 lines. -->
        <Border Grid.Row="4" Padding="6" Margin="0,8,0,0" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}"
                IsVisible="{Binding IsHeadlessConsoleVisible}">
          <Grid RowDefinitions="Auto,180,Auto" Margin="2,2">
            <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.HeadlessServers_ConsoleHeader}"
                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Background="#1B1817" Padding="6">
              <ItemsControl ItemsSource="{Binding HeadlessConsoleLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Mono, monospace"
                               FontSize="11" Foreground="#E6E5E3" TextWrapping="NoWrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBox Grid.Column="0" Text="{Binding HeadlessCommandInput, Mode=TwoWay}"
                       FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11"
                       Watermark="{x:Static loc:Strings.HeadlessServers_CommandWatermark}" />
              <Button Grid.Column="1" Content="{x:Static loc:Strings.HeadlessServers_SendButton}"
                      Command="{Binding SendHeadlessCommand}"
                      FontSize="11" Padding="14,5" Margin="6,0,0,0" />
            </Grid>
          </Grid>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,8,0,0"
                   Text="{x:Static loc:Strings.HeadlessServers_FootnotePath}"
                   Opacity="0.55" FontSize="10" TextWrapping="Wrap" />
      </Grid>

      <!-- ==== MODS PAGE ==== -->
      <Grid IsVisible="{Binding IsModsSelected}" Classes="Page" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Mods_Title}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Mods_Subtitle}"
                     Opacity="0.65" FontSize="11" />
        </StackPanel>

        <!-- Top search bar -->
        <Border Grid.Row="1" Padding="10" Margin="0,0,0,6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto">
            <!-- Source toggle (Modrinth | CurseForge) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="0,0,10,0">
              <RadioButton GroupName="ModSource"
                           IsChecked="{Binding IsModrinthSelected, Mode=OneWay}"
                           Click="OnModSourceModrinth"
                           Padding="10,5" FontSize="11" Content="{x:Static loc:Strings.Mods_SourceModrinth}" />
              <RadioButton GroupName="ModSource"
                           IsChecked="{Binding IsCurseForgeSelected, Mode=OneWay}"
                           Click="OnModSourceCurseForge"
                           Padding="10,5" FontSize="11" Content="{x:Static loc:Strings.Mods_SourceCurseForge}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Mods_SearchLabel}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="2" Text="{Binding ModSearchTerm, Mode=TwoWay}"
                     Watermark="{x:Static loc:Strings.Mods_SearchWatermark}"
                     FontSize="12" />
            <Button Grid.Column="3" Content="{x:Static loc:Strings.Mods_SearchButton}" FontSize="11"
                    Command="{Binding SearchModsCommand}"
                    Padding="14,5" Margin="8,0,0,0" />
          </Grid>
        </Border>

        <!-- Two-pane: results (left) + installed (right) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*">
          <!-- Search results -->
          <Border Grid.Column="0" Padding="6" Margin="0,0,4,0" CornerRadius="15"
                  Background="{DynamicResource MaterialPaperBrush}">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Mods_SearchResults}"
                         FontWeight="SemiBold" FontSize="12" Margin="6,4" />

              <!-- v0.32.1 (T-cf-onboarding): friendly empty-state for the CurseForge tab
                   before the user has configured an API key. Hides the search list and
                   surfaces a "Get started" button that opens the onboarding dialog. -->
              <Border Grid.Row="1" IsVisible="{Binding ShouldShowCurseForgeEmptyState}"
                      Padding="18" Background="Transparent">
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="380">
                  <materialIcons:MaterialIcon Kind="KeyOutline" Width="40" Height="40"
                                              Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                                              HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static loc:Strings.Mods_ConnectHeadline}"
                             FontSize="13" FontWeight="SemiBold"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{x:Static loc:Strings.Mods_ConnectSubhead}"
                             FontSize="11" Opacity="0.7"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" />
                  <Button Content="{x:Static loc:Strings.Mods_GetStartedButton}"
                          Command="{Binding OpenCurseForgeOnboardingCommand}"
                          HorizontalAlignment="Center"
                          Padding="18,6" FontSize="12"
                          CornerRadius="4"
                          Background="{DynamicResource LG.BubbleFillCombined}"
                          BorderBrush="{DynamicResource LG.GlassRimStrong}"
                          BorderThickness="1"
                          Foreground="White" />
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding !ShouldShowCurseForgeEmptyState}">
                <ListBox ItemsSource="{Binding ModSearchResults}"
                         SelectedItem="{Binding SelectedModSearchResult, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="mods:Mod">
                      <Border Padding="6" Margin="2" CornerRadius="15"
                              Background="{DynamicResource MaterialBackgroundBrush}">
                        <Grid ColumnDefinitions="36,*,Auto">
                          <Image Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0"
                                 asyncImageLoader:ImageLoader.Source="{Binding IconUri}" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AuthorDisplay}" FontSize="10" Opacity="0.7" />
                            <TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}"
                                       FontSize="10" Opacity="0.55" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="{x:Static loc:Strings.Mods_InstallButton}" FontSize="10"
                                  Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).InstallModCommand}"
                                  Padding="8,3" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Installed mods (requires instance) -->
          <Border Grid.Column="1" Padding="6" Margin="4,0,0,0" CornerRadius="15"
                  Background="{DynamicResource MaterialPaperBrush}">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,4">
                <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Mods_InstalledInSelectedInstance}"
                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{x:Static loc:Strings.Mods_RefreshButton}" FontSize="10"
                        Command="{Binding RefreshInstalledModsCommand}"
                        Padding="8,3" />
              </Grid>

              <!-- Empty state when no instance selected -->
              <Border Grid.Row="1" IsVisible="{Binding !CanManageInstanceMods}"
                      Padding="14" Background="Transparent">
                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="36" Height="36"
                                              Foreground="{DynamicResource MaterialPrimaryMidBrush}"
                                              HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static loc:Strings.Mods_PickAnInstanceFirst}"
                             FontSize="12" Opacity="0.75" HorizontalAlignment="Center" TextAlignment="Center" />
                  <TextBlock Text="{x:Static loc:Strings.Mods_RightPaneHint}"
                             FontSize="10" Opacity="0.55" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding CanManageInstanceMods}">
                <ListBox ItemsSource="{Binding InstalledMods}"
                         SelectedItem="{Binding SelectedInstalledMod, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="mods:LocalMod">
                      <Border Padding="6" Margin="2" CornerRadius="15"
                              Background="{DynamicResource MaterialBackgroundBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                    Click="OnInstalledModToggleClicked"
                                    Tag="{Binding Filename}"
                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Filename}" FontSize="9" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding SizeBytes, StringFormat='{}{0:N0} B'}"
                                     FontSize="10" Opacity="0.55"
                                     VerticalAlignment="Center" Margin="4,0,8,0" />
                          <Button Grid.Column="3" Content="{x:Static loc:Strings.Mods_RemoveButton}" FontSize="10"
                                  Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveInstalledModCommand}"
                                  Padding="6,3" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ==== NEWS PAGE ==== -->
      <Grid IsVisible="{Binding IsNewsSelected}" Classes="Page" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.News_Title}" FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.News_Subtitle}"
                     Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Row="1" Content="{x:Static loc:Strings.News_RefreshButton}" FontSize="11"
                Command="{Binding RefreshNewsCommand}"
                Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,6" />
        <Border Grid.Row="2" Padding="6" CornerRadius="15"
                Background="{DynamicResource MaterialPaperBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding News}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Padding="10" CornerRadius="15"
                          Background="{DynamicResource MaterialBackgroundBrush}">
                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto">
                      <Image Grid.RowSpan="4" Grid.Column="0"
                             asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}"
                             Width="72" Height="72"
                             Stretch="UniformToFill"
                             Margin="0,0,10,0" VerticalAlignment="Top" />
                      <TextBlock Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Category}" FontSize="10" Opacity="0.7"
                                   Foreground="{DynamicResource MaterialSecondaryMidBrush}" />
                        <TextBlock Text="{Binding Date}" FontSize="10" Opacity="0.55" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Text}" FontSize="11" Opacity="0.85"
                                 TextWrapping="Wrap" Margin="0,4,0,0" />
                      <Button Grid.Row="3" Grid.Column="1"
                              Content="{x:Static loc:Strings.News_ReadMore}" FontSize="10"
                              Tag="{Binding ReadMoreLink}" Click="OnOpenExternalLink"
                              HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- ==== SETTINGS PAGE ==== -->
      <Grid IsVisible="{Binding IsSettingsSelected}" Classes="Page" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Settings_Title}" FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Settings_Subtitle}"
                     Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
          <StackPanel Spacing="8">

            <!-- Memory -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_MemoryHeader}" FontWeight="SemiBold" FontSize="12" />

                <Grid ColumnDefinitions="100,*,80">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_MinimumXmsLabel}" FontSize="11" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="256"
                          Maximum="{Binding MaxAllowedMemoryMb}"
                          Value="{Binding MinMemoryMb, Mode=TwoWay}"
                          TickFrequency="256" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Run Text="{Binding MinMemoryMb}" />
                    <Run Text="{x:Static loc:Strings.Settings_MbUnit}" />
                  </TextBlock>
                </Grid>

                <Grid ColumnDefinitions="100,*,80">
                  <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.Settings_MaximumXmxLabel}" FontSize="11" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="512"
                          Maximum="{Binding MaxAllowedMemoryMb}"
                          Value="{Binding MaxMemoryMb, Mode=TwoWay}"
                          TickFrequency="512" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Run Text="{Binding MaxMemoryMb}" />
                    <Run Text="{x:Static loc:Strings.Settings_MbUnit}" />
                  </TextBlock>
                </Grid>

                <TextBlock FontSize="10" Opacity="0.6">
                  <Run Text="{x:Static loc:Strings.Settings_CeilingPrefix}" />
                  <Run Text="{Binding MaxAllowedMemoryMb}" />
                  <Run Text="{x:Static loc:Strings.Settings_CeilingSuffix}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <!-- JVM args -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_JvmArgsHeader}" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding JvmArguments, Mode=TwoWay}"
                         Watermark="{x:Static loc:Strings.Settings_JvmArgsWatermark}"
                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11"
                         AcceptsReturn="True" Height="56" />
                <TextBlock Text="{x:Static loc:Strings.Settings_JvmArgsHint}"
                           FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Game directory -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_GameDirHeader}" FontWeight="SemiBold" FontSize="12" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding GameDirectoryOverride, Mode=TwoWay}"
                           Watermark="{x:Static loc:Strings.Settings_GameDirWatermark}" FontSize="11" />
                  <Button Grid.Column="1" Content="{x:Static loc:Strings.Settings_BrowseButton}" FontSize="11"
                          Padding="10,4" Margin="6,0,0,0" Click="OnBrowseGameDir" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Java executable -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_JavaExeHeader}" FontWeight="SemiBold" FontSize="12" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding JavaExecutableOverride, Mode=TwoWay}"
                           Watermark="{x:Static loc:Strings.Settings_JavaExeWatermark}" FontSize="11" />
                  <Button Grid.Column="1" Content="{x:Static loc:Strings.Settings_BrowseButton}" FontSize="11"
                          Padding="10,4" Margin="6,0,0,0" Click="OnBrowseJavaExe" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Launcher prefs -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_LauncherPrefsHeader}" FontWeight="SemiBold" FontSize="12" />
                <CheckBox IsChecked="{Binding KeepLauncherOpen, Mode=TwoWay}" FontSize="11"
                          Content="{x:Static loc:Strings.Settings_KeepLauncherOpen}" />
                <CheckBox IsChecked="{Binding ShowGameLog, Mode=TwoWay}" FontSize="11"
                          Content="{x:Static loc:Strings.Settings_ShowGameLog}"
                          ToolTip.Tip="{x:Static loc:Strings.Settings_ShowGameLogTooltip}" />
              </StackPanel>
            </Border>

            <!-- v0.32.1 (T-cf-onboarding): Mods card. Replaces the bare CurseForge API key
                 TextBox with a status row + button that routes through the onboarding dialog.
                 Two states share the same row: "Not configured" / "Configured", each with
                 its own action button label. Both buttons fire the same VM command. -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_ModsHeader}" FontWeight="SemiBold" FontSize="12" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                  <TextBlock Grid.Column="0"
                             Text="{x:Static loc:Strings.Settings_CurseForgeStatusNotConfigured}"
                             FontSize="11" VerticalAlignment="Center"
                             IsVisible="{Binding !HasCurseForgeKey}" />
                  <TextBlock Grid.Column="0"
                             Text="{x:Static loc:Strings.Settings_CurseForgeStatusConfigured}"
                             FontSize="11" VerticalAlignment="Center"
                             IsVisible="{Binding HasCurseForgeKey}" />
                  <Button Grid.Column="1"
                          Content="{x:Static loc:Strings.Settings_SetUpCurseForgeButton}"
                          Command="{Binding OpenCurseForgeOnboardingCommand}"
                          FontSize="11" Padding="10,4"
                          IsVisible="{Binding !HasCurseForgeKey}" />
                  <Button Grid.Column="1"
                          Content="{x:Static loc:Strings.Settings_ChangeKeyButton}"
                          Command="{Binding OpenCurseForgeOnboardingCommand}"
                          FontSize="11" Padding="10,4"
                          IsVisible="{Binding HasCurseForgeKey}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Backups (v0.30 T21f). Pre-launch world snapshot under <gameDir>/backups/ -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_BackupsHeader}" FontWeight="SemiBold" FontSize="12" />
                <CheckBox IsChecked="{Binding AutoBackupBeforeLaunch, Mode=TwoWay}" FontSize="11"
                          Content="{x:Static loc:Strings.Settings_AutoBackupCheckbox}" />
                <Grid ColumnDefinitions="*,80" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Settings_KeepLatestNLabel}" />
                  <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1"
                                 Value="{Binding AutoBackupKeepLatest, Mode=TwoWay}"
                                 FormatString="0" FontSize="11" />
                </Grid>
                <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Settings_BackupHint}" />
              </StackPanel>
            </Border>

            <!-- T22a (v0.31.0): language picker. The dropdown is bound to AvailableLocales
                 (a "(null) Use system default" sentinel followed by one row per culture the
                 launcher ships translations for). Changing the selection fires
                 SetCultureAsync on the localization service; on Save the choice persists into
                 LauncherSettings.Locale. -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static loc:Strings.Settings_LanguageHeader}" FontWeight="SemiBold" FontSize="12" />
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                             Text="{x:Static loc:Strings.Settings_LanguageLabel}" />
                  <ComboBox Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding AvailableLocales}"
                            SelectedValue="{Binding Locale, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Culture}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.Settings_LanguageHint}" />
              </StackPanel>
            </Border>

            <!-- Bug 5 (v0.32.0): manual "Check for updates" button. The startup probe
                 only fires if AutoUpdateCheck is enabled AND a newer GitHub release
                 exists, so the banner could go unseen for entire versions. This card
                 lets the user trigger the same probe on demand; the result is either
                 the banner appearing (newer release found) or a "you're on the latest"
                 line in the launcher log. -->
            <Border Padding="10" Classes="Card" CornerRadius="15" Background="{DynamicResource MaterialPaperBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="12" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                             Text="Manually check GitHub Releases for a newer launcher build." />
                  <Button Grid.Column="1"
                          Content="Check for updates"
                          Command="{Binding CheckForUpdatesCommand}"
                          FontSize="11" Padding="10,4" />
                </Grid>
                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                           Text="If a newer release is available a green banner appears at the top of the window. Otherwise the log shows a 'you're on the latest version' line." />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="{x:Static loc:Strings.Settings_SaveButton}"
                Command="{Binding SaveSettingsCommand}"
                Classes="LaunchBtn"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="18,6" HorizontalAlignment="Right" Margin="0,8,0,0"
                Foreground="White" />
      </Grid>

      <!-- ==== LOGS PAGE ==== -->
      <Grid IsVisible="{Binding IsLogsSelected}" Classes="Page" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,8">
          <TextBlock Text="{x:Static loc:Strings.Logs_Title}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="18" Foreground="White" />
          <TextBlock Text="{x:Static loc:Strings.Logs_Subtitle}"
                     Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Toolbar: filter + refresh + open folder + copy all -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
          <TextBox Grid.Column="0"
                   Text="{Binding LogFilter, Mode=TwoWay}"
                   Watermark="{x:Static loc:Strings.Logs_FilterWatermark}"
                   FontSize="11" />
          <Button Grid.Column="1" Content="{x:Static loc:Strings.Logs_RefreshButton}" FontSize="11"
                  Command="{Binding RefreshLogFileCommand}"
                  Padding="10,4" Margin="6,0,0,0" />
          <Button Grid.Column="2" Content="{x:Static loc:Strings.Logs_OpenLogsFolderButton}" FontSize="11"
                  Click="OnOpenLogsFolder"
                  Padding="10,4" Margin="6,0,0,0" />
          <Button Grid.Column="3" Content="{x:Static loc:Strings.Logs_CopyAllButton}" FontSize="11"
                  Click="OnCopyLogAll"
                  Padding="10,4" Margin="6,0,0,0" />
        </Grid>

        <!-- Log viewer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="15"
                Background="{DynamicResource MaterialBackgroundBrush}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding FilteredLogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                     FontSize="11"
                     Padding="8" />
          </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Text="{Binding LogStatusText}"
                   FontSize="10" Opacity="0.6" Margin="2,6,2,0" />
      </Grid>

    </Grid>

  </Grid>
  </Panel>

  <Window.Styles>
    <!-- Custom window-control buttons (min / max / close) in the title bar, with a 150 ms hover fade
         and no Material elevation shadow. ShadowDepth0 + zero BoxShadow on the templated Border
         covers both Material.Avalonia's own elevation system and any leftover BoxShadow setters. -->
    <!-- Sidebar collapse / expand toggle: a slim icon-only button at the top of the sidebar.
         Keeps the same flat aesthetic as the window-controls (no Material elevation). -->
    <Style Selector="Button.SidebarToggle">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SidebarToggle /template/ Border#PART_RootBorder">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.SidebarToggle:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <Style Selector="Button.WinCtrl">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.WinCtrl /template/ Border#PART_RootBorder">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.WinCtrl:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.WinCtrlClose:pointerover">
      <Setter Property="Background" Value="#E81123" />
    </Style>

    <!-- Launch button: liquid-glass bubble with a spring-y scale. The bubble gradient
         + bubble shadow set make it sit "above" the page surface, matching the big
         CTA bubble in the Flutter prototype. -->
    <Style Selector="Button.LaunchBtn">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Background" Value="{DynamicResource LG.BubbleFillCombined}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRimStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource LG.RadiusButton}" />
      <Setter Property="Foreground" Value="{DynamicResource LG.TextPrimary}" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="QuadraticEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.LaunchBtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource LG.LaunchShadows}" />
      <Setter Property="CornerRadius" Value="{DynamicResource LG.RadiusButton}" />
    </Style>
    <Style Selector="Button.LaunchBtn:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.05)" />
      <Setter Property="Background" Value="{DynamicResource LG.BubbleFillHover}" />
    </Style>
    <Style Selector="Button.LaunchBtn:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Card hover: subtle lift + a soft rim glow. Borders tagged Classes="Card" pick this
         up; the LiquidGlass gradient background is set inline on the Border itself or
         via DynamicResource MaterialPaperBrush (which has been aliased to the glass
         gradient at the Window level). -->
    <Style Selector="Border.Card">
      <Setter Property="RenderTransform" Value="translate(0px,0px)" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="QuadraticEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.Card:pointerover">
      <Setter Property="RenderTransform" Value="translate(0px,-2px)" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRimStrong}" />
    </Style>

    <!-- Avatar tilts on hover so the chip feels alive. -->
    <Style Selector="Image.Avatar">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Image.Avatar:pointerover">
      <Setter Property="RenderTransform" Value="rotate(-8deg) scale(1.08)" />
    </Style>

    <!-- Header chip Sign-in / Sign-out buttons: same family of scale-on-hover as Launch but gentler. -->
    <Style Selector="Button.ChipBtn">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ChipBtn:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>

    <!-- ListBoxItem hover: smooth background fade instead of an instant snap. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Sidebar nav radios: animate the bubble background + a small scale on the icon
         when checked. Idle/hover/checked branches are split across :pointerover and
         :checked pseudo-classes below. -->
    <Style Selector="RadioButton.Nav /template/ Border#PART_Border">
      <Setter Property="RenderTransform" Value="translate(0px,0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.41" Easing="QuadraticEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.41" Easing="QuadraticEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.41" Easing="QuadraticEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.Nav:pointerover /template/ Border#PART_Border">
      <Setter Property="RenderTransform" Value="translate(2px,0px)" />
    </Style>

    <!-- Page content panels: subtle fade-in once visible. The trigger is the
         IsVisible flip when SelectedSection changes - Avalonia animates the
         attached opacity transition together with the layout reveal. -->
    <Style Selector="Grid.Page, Border.Page">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Strip Material.Avalonia's drop-shadow from every header / sidebar control so the
         custom chrome stays flat against the acrylic. -->
    <Style Selector="RadioButton.Nav">
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
    </Style>

    <!-- Per-instance detail-panel tab buttons: radios styled like chunky tabs. -->
    <Style Selector="RadioButton.DetailTab">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.DetailTab /template/ Border#PART_Border">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.DetailTab:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryDarkBrush}" />
    </Style>
    <Style Selector="RadioButton.DetailTab:checked /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryMidBrush}" />
    </Style>

    <!-- Sidebar nav radios styled as full-width liquid-glass tiles. Idle is fully
         transparent; hover paints a thin frosted wash; checked gets the bubble
         gradient + rim + three-layer shadow set from LG.BubbleShadows.

         The Icon ContentPresenter has a small RenderTransform that scales from 1.0
         to 1.25 on :checked, matching the Flutter prototype's icon bounce. -->
    <Style Selector="RadioButton.Nav">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource LG.RadiusItem}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource LG.TextPrimary}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- Icon stays in column 0; the label ContentPresenter in column 1 collapses
                 to zero width via IsVisible=false when the sidebar is collapsed, which leaves
                 just the 20x20 icon visible inside the 56px-wide collapsed sidebar. -->
            <Grid ColumnDefinitions="20,Auto">
              <ContentPresenter Name="PART_IconHost"
                                Grid.Column="0" Content="{TemplateBinding Tag}"
                                Width="20" Height="20"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RenderTransformOrigin="50%,50%">
                <ContentPresenter.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </ContentPresenter.RenderTransform>
              </ContentPresenter>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                VerticalAlignment="Center" Margin="10,0,0,0"
                                IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).AreSidebarLabelsVisible}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.Nav:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource LG.RowHover}" />
    </Style>
    <Style Selector="RadioButton.Nav:checked /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource LG.BubbleFillCombined}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRimStrong}" />
      <Setter Property="BoxShadow" Value="{DynamicResource LG.BubbleShadows}" />
    </Style>
    <Style Selector="RadioButton.Nav:checked:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource LG.BubbleFillHover}" />
    </Style>

    <!-- Icon scale: 1.0 idle, 1.25 when the radio is :checked. Animation = 240ms
         QuadraticEaseOut (Avalonia's closest stock easing to Flutter's easeOutBack). -->
    <Style Selector="RadioButton.Nav /template/ ContentPresenter#PART_IconHost">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="RadioButton.Nav:checked /template/ ContentPresenter#PART_IconHost">
      <Setter Property="RenderTransform" Value="scale(1.25)" />
    </Style>

    <!-- Version-picker filter chips. ToggleButton styled flat: a pill that tints when
         checked and stays neutral otherwise. Mirrors the Tag chips seen on other
         Minecraft launchers (Prism / MultiMC) and keeps the row compact above the
         dropdown so it doesn't crowd the manifest box. -->
    <Style Selector="ToggleButton.Chip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.Chip /template/ Border#PART_RootBorder">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="ToggleButton.Chip:pointerover">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.Chip:checked">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryMidBrush}" />
    </Style>
    <Style Selector="ToggleButton.Chip:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryLightBrush}" />
    </Style>

    <!-- =================== COMBOBOX (v0.32.0 bug 1) ===================
         The previous translucent MaterialPaperBrush leaked the page through both the
         closed slot and the open dropdown popup. Pin the closed slot to the surface
         tile (#262423) with a 1px dark pixel outline, and force the popup's child
         Border (and inner ScrollViewer / ItemsPresenter) to the same opaque surface
         so the popup never lets the page bleed through. Two selectors cover both
         the stock Avalonia popup name (PART_PopupBorder) and the bare Border child
         of PART_Popup that some Material.Avalonia templates render. -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource LG.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource LG.RadiusItem}" />
      <Setter Property="Foreground" Value="{DynamicResource LG.TextPrimary}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PART_PopupBorder">
      <Setter Property="Background" Value="{DynamicResource LG.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox /template/ Popup#PART_Popup > Border">
      <Setter Property="Background" Value="{DynamicResource LG.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LG.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Some Material.Avalonia templates wrap the popup in a ScrollViewer rather than
         a named Border; paint the ScrollViewer too so a transparent ScrollViewer
         doesn't expose the page underneath. -->
    <Style Selector="ComboBox /template/ Popup#PART_Popup ScrollViewer">
      <Setter Property="Background" Value="{DynamicResource LG.Surface}" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LG.TextPrimary}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LG.RowHover}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LG.RowSelected}" />
    </Style>
  </Window.Styles>

</Window>

