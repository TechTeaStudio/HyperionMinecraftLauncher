<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:TechTeaStudio.HyperionMinecraftLauncher.App.Localization"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.CurseForgeOnboardingDialog"
        x:Name="OnboardingRoot"
        Title="{x:Static loc:Strings.CurseForgeOnboardingDialog_Title}"
        Width="520" Height="380"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LG.WindowBackground}"
        FontFamily="Inter, Segoe UI, system-ui">

  <Border Background="{DynamicResource LG.GlassSurface}"
          BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
          CornerRadius="4">
    <Grid RowDefinitions="36,*,Auto">

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#400D0D1B"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{x:Static loc:Strings.CurseForgeOnboardingDialog_HeaderTitle}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Classes="WinCtrl WinCtrlClose"
                  Width="36" Height="36">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" Margin="22,14,22,4" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">

          <TextBlock Text="{x:Static loc:Strings.CurseForgeOnboardingDialog_Heading}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="15"
                     Foreground="White" />

          <!-- Step 1 -->
          <Grid ColumnDefinitions="26,*">
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                    Background="{DynamicResource MC.AccentGreen}"
                    VerticalAlignment="Top">
              <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" FontSize="12"
                       Text="{x:Static loc:Strings.CurseForgeOnboardingDialog_Step1Body}"
                       TextWrapping="Wrap" Margin="6,2,0,0" />
          </Grid>

          <!-- Step 2 -->
          <Grid ColumnDefinitions="26,*">
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                    Background="{DynamicResource MC.AccentGreen}"
                    VerticalAlignment="Top">
              <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Button Grid.Column="1"
                    Content="{x:Static loc:Strings.CurseForgeOnboardingDialog_Step2Button}"
                    Click="OnOpenConsole"
                    Padding="14,6" FontSize="12" Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    CornerRadius="4"
                    Background="{DynamicResource LG.BubbleFillCombined}"
                    BorderBrush="{DynamicResource LG.GlassRimStrong}"
                    BorderThickness="1"
                    Foreground="White" />
          </Grid>

          <!-- Step 3 -->
          <Grid ColumnDefinitions="26,*">
            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                    Background="{DynamicResource MC.AccentGreen}"
                    VerticalAlignment="Top">
              <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" Margin="6,2,0,0">
              <TextBlock Text="{x:Static loc:Strings.CurseForgeOnboardingDialog_Step3Label}"
                         FontSize="12" />
              <TextBox x:Name="KeyTextBox"
                       Text="{Binding #OnboardingRoot.EnteredApiKey, Mode=TwoWay}"
                       Watermark="{x:Static loc:Strings.CurseForgeOnboardingDialog_KeyWatermark}"
                       FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                       FontSize="11" />
            </StackPanel>
          </Grid>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Grid Grid.Row="2" Margin="22,8,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1"
                Content="{x:Static loc:Strings.CurseForgeOnboardingDialog_CancelButton}"
                Click="OnCancel"
                Padding="20,6" FontSize="12" Margin="0,0,8,0"
                CornerRadius="4" />
        <Button Grid.Column="2"
                Content="{x:Static loc:Strings.CurseForgeOnboardingDialog_SaveButton}"
                Click="OnSave"
                Padding="20,6" FontSize="12"
                CornerRadius="4"
                Background="{DynamicResource LG.BubbleFillCombined}"
                BorderBrush="{DynamicResource LG.GlassRimStrong}"
                BorderThickness="1"
                Foreground="White" />
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.WinCtrl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.WinCtrl:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.WinCtrlClose:pointerover">
      <Setter Property="Background" Value="#E81123" />
    </Style>
  </Window.Styles>
</Window>
