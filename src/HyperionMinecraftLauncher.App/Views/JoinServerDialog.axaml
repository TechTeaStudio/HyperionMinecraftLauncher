<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:instances="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Instances"
        xmlns:loc="using:TechTeaStudio.HyperionMinecraftLauncher.App.Localization"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.JoinServerDialog"
        Title="{x:Static loc:Strings.JoinServerDialog_Title}"
        Width="460" Height="220"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LG.WindowBackground}"
        FontFamily="Inter, Segoe UI, system-ui"
        RenderOptions.BitmapInterpolationMode="None">

  <Border Background="{DynamicResource LG.GlassSurface}"
          BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
          CornerRadius="15">
    <Grid RowDefinitions="36,*,Auto">

      <Border Grid.Row="0" Background="#400D0D1B"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.JoinServerDialog_HeaderTitle}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Width="36" Height="36"
                  Background="Transparent" BorderThickness="0" CornerRadius="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="20,16" Spacing="12">
        <TextBlock x:Name="QuestionText" FontSize="13" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static loc:Strings.JoinServerDialog_PickInstance}" FontSize="11" Opacity="0.85" />
          <ComboBox x:Name="InstanceBox" HorizontalAlignment="Stretch" PlaceholderText="{x:Static loc:Strings.JoinServerDialog_NoInstancesPlaceholder}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="instances:Instance">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding VersionId}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="2" Margin="20,4,20,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Cancel}" Click="OnCancel"
                Padding="14,5" FontSize="12" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="{x:Static loc:Strings.JoinServerDialog_JoinButton}"
                Click="OnConfirm"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="14,5"
                CornerRadius="15"
                Background="{DynamicResource LG.BubbleFillCombined}"
                BorderBrush="{DynamicResource LG.GlassRimStrong}"
                BorderThickness="1"
                Foreground="White" />
      </Grid>
    </Grid>
  </Border>
</Window>
