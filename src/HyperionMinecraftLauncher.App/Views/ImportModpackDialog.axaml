<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TechTeaStudio.HyperionMinecraftLauncher.App.ViewModels"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.ImportModpackDialog"
        x:DataType="vm:MainViewModel"
        Title="Import modpack"
        Width="480" Height="260"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LG.WindowBackground}"
        FontFamily="Inter, Segoe UI, system-ui"
        RenderOptions.BitmapInterpolationMode="None">

  <Border Background="{DynamicResource LG.GlassSurface}"
          BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
          CornerRadius="15">
    <Grid RowDefinitions="36,*,Auto">

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#400D0D1B" PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Import modpack"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Width="36" Height="36"
                  Background="Transparent" BorderThickness="0" CornerRadius="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <!-- Body -->
      <StackPanel Grid.Row="1" Margin="22,16" Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Archive" FontSize="12" Opacity="0.85" />
          <TextBlock x:Name="ArchivePathBox" Text="(no file picked)"
                     FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Instance name" FontSize="12" Opacity="0.85" />
          <TextBox x:Name="NameBox" Text="" Watermark="(uses pack name if empty)" FontSize="13" />
        </StackPanel>
        <TextBlock Text="The archive is auto-detected as Modrinth .mrpack or CurseForge .zip and imported into a fresh instance folder."
                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Footer -->
      <Grid Grid.Row="2" Margin="22,4,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="Cancel" Click="OnCancel"
                Padding="14,5" FontSize="12" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Import"
                Click="OnImport"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="14,5"
                CornerRadius="15"
                Background="{DynamicResource LG.BubbleFillCombined}"
                BorderBrush="{DynamicResource LG.GlassRimStrong}"
                BorderThickness="1"
                Foreground="White" />
      </Grid>
    </Grid>
  </Border>
</Window>
