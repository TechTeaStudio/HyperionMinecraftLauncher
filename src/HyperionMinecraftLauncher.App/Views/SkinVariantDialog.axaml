<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.SkinVariantDialog"
        Title="Choose skin variant"
        Width="380" Height="200"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialPaperBrush}"
        FontFamily="Inter, Segoe UI, system-ui">

  <Border BorderBrush="{DynamicResource MaterialPrimaryMidBrush}" BorderThickness="1" CornerRadius="6">
    <Grid RowDefinitions="36,*,Auto">
      <Border Grid.Row="0" Background="{DynamicResource MaterialPrimaryDarkBrush}"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Choose skin variant"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Classes="WinCtrl WinCtrlClose"
                  Width="36" Height="36">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="22,12,22,4" Spacing="6">
        <TextBlock Text="Which arm width does this skin use?" FontSize="13" />
        <TextBlock Text="Classic = 4-pixel arms (Steve). Slim = 3-pixel arms (Alex)."
                   Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="2" Margin="22,8,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="Classic" Click="OnClassic"
                Padding="20,6" FontSize="12" Margin="0,0,8,0"
                Background="{DynamicResource MaterialPrimaryMidBrush}" Foreground="White" />
        <Button Grid.Column="2" Content="Slim" Click="OnSlim"
                Padding="20,6" FontSize="12" />
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <Style Selector="Button.WinCtrl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.WinCtrl:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.WinCtrlClose:pointerover">
      <Setter Property="Background" Value="#E81123" />
    </Style>
  </Window.Styles>
</Window>
