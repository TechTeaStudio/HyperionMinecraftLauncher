<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:TechTeaStudio.HyperionMinecraftLauncher.App.Views"
        xmlns:versions="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Versions"
        xmlns:vm="using:TechTeaStudio.HyperionMinecraftLauncher.App.ViewModels"
        xmlns:sys="using:System"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.NewInstanceDialog"
        x:DataType="vm:MainViewModel"
        Title="New Instance"
        Width="560" Height="520"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialPaperBrush}"
        FontFamily="Inter, Segoe UI, system-ui"
        RenderOptions.BitmapInterpolationMode="None">

  <Border BorderBrush="{DynamicResource MaterialPrimaryMidBrush}" BorderThickness="1" CornerRadius="6">
    <Grid RowDefinitions="36,*,Auto">

      <!-- Title bar -->
      <Border Grid.Row="0" Background="{DynamicResource MaterialPrimaryDarkBrush}"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Create a new instance"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Width="36" Height="36"
                  Background="Transparent" BorderThickness="0" CornerRadius="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
        <StackPanel Spacing="14">

          <!-- Name -->
          <StackPanel Spacing="4">
            <TextBlock Text="Instance name" FontSize="12" Opacity="0.85" />
            <TextBox x:Name="NameBox" Text="My new instance"
                     Watermark="My new instance" FontSize="13" />
          </StackPanel>

          <!-- Version picker -->
          <StackPanel Spacing="4">
            <TextBlock Text="Minecraft version" FontSize="12" Opacity="0.85" />

            <!-- Search box. Binds straight to MainViewModel.VersionSearchText so the
                 filter is shared with the Home page. -->
            <TextBox Text="{Binding VersionSearchText, Mode=TwoWay}"
                     Watermark="Search version..."
                     FontSize="11" />

            <!-- Type-filter chips, identical to the Home page row. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
              <ToggleButton Content="Release"   Classes="Chip" IsChecked="{Binding ShowRelease,  Mode=TwoWay}" />
              <ToggleButton Content="Snapshot"  Classes="Chip" IsChecked="{Binding ShowSnapshot, Mode=TwoWay}" />
              <ToggleButton Content="Old beta"  Classes="Chip" IsChecked="{Binding ShowOldBeta,  Mode=TwoWay}" />
              <ToggleButton Content="Old alpha" Classes="Chip" IsChecked="{Binding ShowOldAlpha, Mode=TwoWay}" />
            </StackPanel>

            <ComboBox x:Name="VersionBox" PlaceholderText="(loading manifest ...)"
                      ItemsSource="{Binding FilteredVersions}"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="versions:VersionMetadata">
                  <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Filter chips and search are shared with the Home page picker."
                       FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Icon picker -->
          <StackPanel Spacing="4">
            <TextBlock Text="Icon" FontSize="12" Opacity="0.85" />
            <ItemsControl x:Name="IconPicker">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sys:String">
                  <RadioButton GroupName="IconChoice"
                              Margin="2"
                              Tag="{Binding}"
                              Click="OnIconClicked"
                              Width="48" Height="48"
                              Background="{DynamicResource MaterialBackgroundBrush}"
                              BorderBrush="{DynamicResource MaterialPrimaryMidBrush}"
                              BorderThickness="1">
                    <Image Source="{ReflectionBinding Converter={x:Static local:IconKeyToUri.Instance}}"
                           Width="28" Height="28" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Grid Grid.Row="2" Margin="22,4,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="Cancel" Click="OnCancel"
                Padding="14,5" FontSize="12" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Create"
                Click="OnCreate"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="14,5"
                Background="{DynamicResource MaterialPrimaryMidBrush}" Foreground="White" />
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <!-- Filter chips: shared visual language with the Home page row. -->
    <Style Selector="ToggleButton.Chip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.Chip /template/ Border#PART_RootBorder">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="ToggleButton.Chip:pointerover">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.Chip:checked">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryMidBrush}" />
    </Style>
    <Style Selector="ToggleButton.Chip:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryLightBrush}" />
    </Style>
  </Window.Styles>
</Window>
