<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:TechTeaStudio.HyperionMinecraftLauncher.App.Views"
        xmlns:versions="using:TechTeaStudio.HyperionMinecraftLauncher.Core.Versions"
        xmlns:vm="using:TechTeaStudio.HyperionMinecraftLauncher.App.ViewModels"
        xmlns:sys="using:System"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:loc="using:TechTeaStudio.HyperionMinecraftLauncher.App.Localization"
        mc:Ignorable="d"
        x:Class="TechTeaStudio.HyperionMinecraftLauncher.App.Views.NewInstanceDialog"
        x:DataType="vm:MainViewModel"
        Title="{x:Static loc:Strings.NewInstanceDialog_Title}"
        Width="560" Height="520"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LG.WindowBackground}"
        FontFamily="Inter, Segoe UI, system-ui"
        RenderOptions.BitmapInterpolationMode="None">

  <Border Background="{DynamicResource LG.GlassSurface}"
          BorderBrush="{DynamicResource LG.GlassRim}" BorderThickness="1"
          CornerRadius="15">
    <Grid RowDefinitions="36,*,Auto">

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#400D0D1B"
              PointerPressed="OnTitleBarPressed">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.NewInstanceDialog_HeaderTitle}"
                     FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                     Foreground="White" VerticalAlignment="Center" Margin="12,0" />
          <Button Grid.Column="1" Click="OnCancel" Width="36" Height="36"
                  Background="Transparent" BorderThickness="0" CornerRadius="0">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="White" StrokeThickness="1.2"
                  Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
        <StackPanel Spacing="14">

          <!-- Name -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.NewInstanceDialog_InstanceNameLabel}" FontSize="12" Opacity="0.85" />
            <TextBox x:Name="NameBox" Text="{x:Static loc:Strings.NewInstanceDialog_DefaultInstanceName}"
                     Watermark="{x:Static loc:Strings.NewInstanceDialog_DefaultInstanceName}" FontSize="13" />
          </StackPanel>

          <!-- Version picker -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.NewInstanceDialog_MinecraftVersionLabel}" FontSize="12" Opacity="0.85" />

            <!-- Search box. Binds straight to MainViewModel.VersionSearchText so the
                 filter is shared with the Home page. -->
            <TextBox Text="{Binding VersionSearchText, Mode=TwoWay}"
                     Watermark="{x:Static loc:Strings.NewInstanceDialog_SearchVersionWatermark}"
                     FontSize="11" />

            <!-- Type-filter chips, identical to the Home page row. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipRelease}"   Classes="Chip" IsChecked="{Binding ShowRelease,  Mode=TwoWay}" />
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipSnapshot}"  Classes="Chip" IsChecked="{Binding ShowSnapshot, Mode=TwoWay}" />
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipOldBeta}"  Classes="Chip" IsChecked="{Binding ShowOldBeta,  Mode=TwoWay}" />
              <ToggleButton Content="{x:Static loc:Strings.Home_ChipOldAlpha}" Classes="Chip" IsChecked="{Binding ShowOldAlpha, Mode=TwoWay}" />
            </StackPanel>

            <ComboBox x:Name="VersionBox" PlaceholderText="{x:Static loc:Strings.NewInstanceDialog_LoadingManifest}"
                      ItemsSource="{Binding FilteredVersions}"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="versions:VersionMetadata">
                  <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{x:Static loc:Strings.NewInstanceDialog_FiltersSharedHint}"
                       FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Loader picker (chips: Vanilla / Fabric / Forge / NeoForge / Quilt). v0.30.0 (T21a):
               when a non-Vanilla chip is picked, the LoaderVersionBox below populates with the
               available loader builds for the selected Minecraft version and the chosen build
               is installed automatically before the first launch. -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.NewInstanceDialog_ModLoaderLabel}" FontSize="12" Opacity="0.85" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <RadioButton GroupName="LoaderChoice" Content="{x:Static loc:Strings.NewInstanceDialog_LoaderVanilla}" Tag="None"
                           IsChecked="True" Click="OnLoaderClicked"
                           Padding="10,4" FontSize="11" />
              <RadioButton GroupName="LoaderChoice" Content="{x:Static loc:Strings.NewInstanceDialog_LoaderFabric}" Tag="Fabric"
                           Click="OnLoaderClicked" Padding="10,4" FontSize="11" />
              <RadioButton GroupName="LoaderChoice" Content="{x:Static loc:Strings.NewInstanceDialog_LoaderForge}" Tag="Forge"
                           Click="OnLoaderClicked" Padding="10,4" FontSize="11" />
              <RadioButton GroupName="LoaderChoice" Content="{x:Static loc:Strings.NewInstanceDialog_LoaderNeoForge}" Tag="NeoForge"
                           Click="OnLoaderClicked" Padding="10,4" FontSize="11" />
              <RadioButton GroupName="LoaderChoice" Content="{x:Static loc:Strings.NewInstanceDialog_LoaderQuilt}" Tag="Quilt"
                           Click="OnLoaderClicked" Padding="10,4" FontSize="11" />
            </StackPanel>

            <!-- Loader version dropdown: hidden by default, shown once a non-Vanilla loader chip is
                 picked. Populated by NewInstanceDialog.OnLoaderClicked via MainViewModel.ListLoaderVersionsAsync. -->
            <StackPanel x:Name="LoaderVersionPanel" Spacing="3" Margin="0,4,0,0" IsVisible="False">
              <TextBlock Text="{x:Static loc:Strings.NewInstanceDialog_LoaderVersionLabel}" FontSize="11" Opacity="0.75" />
              <ComboBox x:Name="LoaderVersionBox" PlaceholderText="{x:Static loc:Strings.NewInstanceDialog_LoaderVersionPlaceholder}"
                        HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LoaderVersionHint" FontSize="10" Opacity="0.55"
                         TextWrapping="Wrap"
                         Text="{x:Static loc:Strings.NewInstanceDialog_LoaderHint}" />
            </StackPanel>
          </StackPanel>

          <!-- Icon picker -->
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.NewInstanceDialog_IconLabel}" FontSize="12" Opacity="0.85" />
            <ItemsControl x:Name="IconPicker">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sys:String">
                  <RadioButton GroupName="IconChoice"
                              Margin="2"
                              Tag="{Binding}"
                              Click="OnIconClicked"
                              Width="48" Height="48"
                              Background="{DynamicResource MaterialBackgroundBrush}"
                              BorderBrush="{DynamicResource MaterialPrimaryMidBrush}"
                              BorderThickness="1">
                    <Image Source="{ReflectionBinding Converter={x:Static local:IconKeyToUri.Instance}}"
                           Width="28" Height="28" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Grid Grid.Row="2" Margin="22,4,22,16" ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" Content="{x:Static loc:Strings.Common_Cancel}" Click="OnCancel"
                Padding="14,5" FontSize="12" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="{x:Static loc:Strings.NewInstanceDialog_CreateButton}"
                Click="OnCreate"
                FontFamily="{StaticResource MinecraftFont}" FontSize="13"
                Padding="14,5"
                CornerRadius="15"
                Background="{DynamicResource LG.BubbleFillCombined}"
                BorderBrush="{DynamicResource LG.GlassRimStrong}"
                BorderThickness="1"
                Foreground="White" />
      </Grid>
    </Grid>
  </Border>

  <Window.Styles>
    <!-- Filter chips: shared visual language with the Home page row. -->
    <Style Selector="ToggleButton.Chip">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.Chip /template/ Border#PART_RootBorder">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="ToggleButton.Chip:pointerover">
      <Setter Property="Background" Value="#55FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.Chip:checked">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryMidBrush}" />
    </Style>
    <Style Selector="ToggleButton.Chip:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryLightBrush}" />
    </Style>
  </Window.Styles>
</Window>
