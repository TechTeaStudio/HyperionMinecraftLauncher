<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>TechTeaStudio.HyperionMinecraftLauncher.Core</RootNamespace>
    <AssemblyName>TechTeaStudio.HyperionMinecraftLauncher.Core</AssemblyName>
    <Version>0.31.0</Version>
    <Description>Core library for a CmlLib-backed Minecraft launcher: launcher service contract, exception model, DTOs, file logger.</Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <!--
      Mod-loader installers (T21a, v0.30.0). Forge + NeoForge ship as .NET
      packages on top of CmlLib.Core 4.x. Fabric and Quilt have no NuGet
      installer of their own - the installer we ship calls their official
      meta APIs (meta.fabricmc.net / meta.quiltmc.org) directly, which is
      what every third-party launcher (Prism, MultiMC, ATLauncher) does.
    -->
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="fNbt" Version="1.0.0" />
    <!--
      Logging stack for SerilogLauncherLogger. The house Serilog.TechTeaStudio.Wrap
      package exists on nuget.org but its public LoggerOptions does not expose the
      per-file size cap (FileSizeLimitBytes) we need for the 32 MB roll. We use the
      underlying Serilog primitives directly so the size cap can be honored.
    -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
